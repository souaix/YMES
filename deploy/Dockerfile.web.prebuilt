# Runtime-only alternative for memory-constrained deployment hosts.
# Build context must contain a locally validated dist/ and web/nginx.conf as nginx.conf.
FROM nginxinc/nginx-unprivileged:1.27-alpine
USER root
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html/
RUN chmod -R a+rX /etc/nginx/conf.d /usr/share/nginx/html
USER 101
EXPOSE 8080
