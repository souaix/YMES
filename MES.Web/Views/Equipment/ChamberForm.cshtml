@model ChamberWriteRequest
@{ var edit = Model.DataStamp > 0; ViewData["Title"] = edit ? "編輯 Chamber" : "新增 Chamber"; var action = edit ? "EditChamber" : "NewChamber"; }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Index" asp-route-selectedEquipmentNo="@Model.BelongEquipmentNo">← 返回設備明細</a><div class="eyebrow">EQUIPMENT CHAMBER</div><h1>@(edit ? "編輯 Chamber" : "新增 Chamber")</h1><p>Chamber 是父設備的子資源；建立後需核准才能轉為 ACTIVE。</p></div></div>
<form asp-action="@action" asp-route-parentEquipmentNo="@Model.BelongEquipmentNo" asp-route-chamberNo="@Model.EquipmentNo" method="post" class="equipment-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="DataStamp" type="hidden"/><input asp-for="BelongEquipmentNo" type="hidden"/>
<section class="form-card"><div class="form-card-heading"><span class="form-step">01</span><div><h2>Chamber 資料</h2><p>所屬父設備：@Model.BelongEquipmentNo</p></div><span class="required-note"><i>*</i> 必填</span></div><div class="form-grid"><label class="field"><span>Chamber 編號 <i>*</i></span><input asp-for="EquipmentNo" readonly="@edit" placeholder="例如 CH-ETCH-01-C"/><span asp-validation-for="EquipmentNo" class="field-error"></span></label><label class="field"><span>Chamber 名稱 <i>*</i></span><input asp-for="EquipmentName"/><span asp-validation-for="EquipmentName" class="field-error"></span></label><label class="field field-wide"><span>說明</span><textarea asp-for="Description" rows="3"></textarea></label></div></section>
<div class="form-actions"><a class="button button-outline" asp-action="Index" asp-route-selectedEquipmentNo="@Model.BelongEquipmentNo">取消</a><button class="button button-primary">儲存 Chamber</button></div></form>
