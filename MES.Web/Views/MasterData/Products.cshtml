@model ProductIndexViewModel
@{
    ViewData["Title"] = "產品主檔"; ViewData["ActiveMaster"] = "Products";
    string State(int s) => s switch { 0 => "UNFROZEN", 1 => "PENDING", 2 => "ACTIVE", -1 => "UNUSED", _ => "UNKNOWN" };
    string Css(int s) => s switch { 0 => "draft", 1 => "pending", 2 => "active", -1 => "unused", _ => "" };
}
<div class="page-heading winform-page-heading"><div><div class="eyebrow">PRODUCT MANAGEMENT</div><h1>產品主檔</h1><p>管理產品版本、產品流程指派與產品 BOM。</p><span class="winform-screen-code">WinForms 對照：frmProductBasis</span></div><a class="button button-primary" asp-action="NewProduct">＋ 新增產品</a></div>
@await Html.PartialAsync("_Notice")
<section class="master-workspace winform-workspace"><div class="list-panel"><div class="panel-heading"><div><h2>產品版本清單</h2><span class="panel-subtitle">共 @Model.Items.Count 筆符合條件</span></div><span class="table-count">@Model.Items.Count ITEMS</span></div>
<form class="filter-bar winform-query" method="get" asp-action="Products">
@await Html.PartialAsync("_WinFormIssueStateFilter", Model.IssueState)
<span class="winform-search-label">產品</span><select name="searchField" aria-label="查詢欄位"><option value="ProductNo">產品編號</option></select>
<label class="search-box"><input type="search" name="keyword" value="@Model.Keyword" aria-label="產品編號" /></label><span class="winform-like">%</span>
<button class="button button-filter" type="submit">查詢</button></form>
<div class="winform-function-bar" role="toolbar" aria-label="產品主檔功能"><span class="winform-function-title">FUNCTION</span>
<a class="winform-button winform-button-primary" asp-action="NewProduct">新增產品 (A)</a>
@if (Model.Selected is { } copyItem) { <a class="winform-button" asp-action="CopyProduct" asp-route-no="@copyItem.ProductNo" asp-route-version="@copyItem.ProductVersion">複製(C)</a> }
@if (Model.Selected is { } actionItem)
{
    @if (actionItem.IssueState == 0) { <a class="winform-button" asp-action="EditProduct" asp-route-no="@actionItem.ProductNo" asp-route-version="@actionItem.ProductVersion">修改</a><form asp-action="ApproveProduct" method="post" class="winform-command-form"><input type="hidden" name="no" value="@actionItem.ProductNo" /><input type="hidden" name="version" value="@actionItem.ProductVersion" /><input type="hidden" name="stamp" value="@actionItem.DataStamp" /><button class="winform-button">核准</button></form> }
    @if (actionItem.IssueState == 2) { <form asp-action="NewProductVersion" method="post" class="winform-command-form"><input type="hidden" name="no" value="@actionItem.ProductNo" /><input type="hidden" name="version" value="@actionItem.ProductVersion" /><button class="winform-button">複製新版本</button></form>@if (!actionItem.CurrentVersion) { <form asp-action="SetCurrentProduct" method="post" class="winform-command-form"><input type="hidden" name="no" value="@actionItem.ProductNo" /><input type="hidden" name="version" value="@actionItem.ProductVersion" /><input type="hidden" name="stamp" value="@actionItem.DataStamp" /><button class="winform-button">設為目前版</button></form> } }
    @if (actionItem.IssueState is 0 or 2 or -1) { <form asp-action="DeleteProduct" method="post" class="winform-command-form" onsubmit="return confirm('確定刪除或停用 @actionItem.ProductNo/@actionItem.ProductVersion？');"><input type="hidden" name="no" value="@actionItem.ProductNo" /><input type="hidden" name="version" value="@actionItem.ProductVersion" /><input type="hidden" name="state" value="@actionItem.IssueState" /><input type="hidden" name="stamp" value="@actionItem.DataStamp" /><button class="winform-button winform-button-danger">@(actionItem.IssueState == 2 ? "停用" : "刪除")</button></form> }
}
<a class="winform-button" href="#product-processes">產品流程</a><a class="winform-button" href="#product-bom">產品 BOM</a><button class="winform-button" type="button" disabled title="產品屬性 API 尚未提供">屬性</button><button class="winform-button" type="button" disabled title="產品參數 API 尚未提供">參數</button><button class="winform-button" type="button" disabled title="產品匯入 API 尚未提供">匯入</button><button class="winform-button" type="button" data-export-csv data-filename="products.csv">Download</button><button class="winform-button" type="button" data-print>Print</button><a class="winform-button" href="#" data-close-window>關閉</a>
<span class="winform-toolbar-separator"></span><span class="winform-selection">符合 @Model.Items.Count 筆；選取 @(Model.Selected is null ? "—" : $"{Model.Selected.ProductNo}/{Model.Selected.ProductVersion}")</span></div>
<div class="table-scroll"><table class="equipment-table master-list-table"><thead><tr><th>產品編號</th><th>產品版本</th><th>產品名稱</th><th>產品類型</th><th>單位類型</th><th>庫存單位</th><th>Lot 標準量</th><th>規格編號</th><th>產品代碼</th><th>Lot 序號類型</th><th>Component 序號類型</th><th>ERP 編號</th><th>目前版本</th></tr></thead><tbody>
@foreach (var row in Model.Items)
{
    <tr class="@(Model.Selected?.ProductNo == row.ProductNo && Model.Selected?.ProductVersion == row.ProductVersion ? "selected-row" : "")" onclick="location.href='@Url.Action("Products", new { keyword = Model.Keyword, issueState = Model.IssueState, no = row.ProductNo, version = row.ProductVersion })'"><td class="equipment-code">@row.ProductNo</td><td>@row.ProductVersion</td><td>@row.ProductName</td><td>@row.ProductType</td><td>@row.UnitType</td><td>@row.UnitNo</td><td>@row.LotStdQty.ToString("0.###")</td><td>@row.SpecNo</td><td>@row.ProductCode</td><td>@row.SerialTypeNoLot</td><td>@row.SerialTypeNoComp</td><td>@row.ErpNo</td><td>@(row.CurrentVersion ? "Y" : "N")</td></tr>
}
@if (Model.Items.Count == 0) { <tr><td colspan="13" class="empty-state">沒有符合條件的產品版本</td></tr> }
</tbody></table></div><div class="list-footer">資料總筆數 <strong>@Model.Items.Count</strong></div></div>
<aside class="detail-panel product-detail">@if (Model.Selected is { } x) { <div class="detail-header"><div class="detail-symbol">◇</div><div class="detail-title"><span class="eyebrow">PRODUCT DETAIL</span><h2>@x.ProductNo / @x.ProductVersion</h2><p>@x.ProductName</p></div><span class="status-pill @Css(x.IssueState)"><i></i>@State(x.IssueState)</span></div>
<div class="detail-actions">@if (x.IssueState == 0) { <a class="button button-outline" asp-action="EditProduct" asp-route-no="@x.ProductNo" asp-route-version="@x.ProductVersion">編輯資料</a><form asp-action="ApproveProduct" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProductNo"/><input type="hidden" name="version" value="@x.ProductVersion"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-primary">核准</button></form> }
@if (x.IssueState == 2) { <form asp-action="NewProductVersion" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProductNo"/><input type="hidden" name="version" value="@x.ProductVersion"/><button class="button button-outline">複製新版本</button></form>@if (!x.CurrentVersion) { <form asp-action="SetCurrentProduct" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProductNo"/><input type="hidden" name="version" value="@x.ProductVersion"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-outline">設為目前版</button></form> } }
@if (x.IssueState is 0 or 2 or -1) { <form asp-action="DeleteProduct" method="post" class="inline-form" onsubmit="return confirm('確定刪除或停用 @x.ProductNo/@x.ProductVersion？')"><input type="hidden" name="no" value="@x.ProductNo"/><input type="hidden" name="version" value="@x.ProductVersion"/><input type="hidden" name="state" value="@x.IssueState"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-ghost-danger">@(x.IssueState == 2 ? "停用" : "刪除")</button></form> }</div>
<div class="detail-section"><div class="section-heading"><h3>產品資料</h3><span>@(x.CurrentVersion ? "CURRENT VERSION" : "REVISION")</span></div><dl class="detail-grid"><div><dt>產品類型</dt><dd>@x.ProductType</dd></div><div><dt>庫存單位</dt><dd>@x.UnitNo</dd></div><div><dt>Lot 標準量</dt><dd>@x.LotStdQty.ToString("0.###")</dd></div><div><dt>ERP 編號</dt><dd>@(string.IsNullOrWhiteSpace(x.ErpNo) ? "—" : x.ErpNo)</dd></div><div><dt>產品規格</dt><dd>@(string.IsNullOrWhiteSpace(x.SpecNo) ? "—" : x.SpecNo)</dd></div><div><dt>產品代碼</dt><dd>@(string.IsNullOrWhiteSpace(x.ProductCode) ? "—" : x.ProductCode)</dd></div><div><dt>Lot 序號類型</dt><dd>@(string.IsNullOrWhiteSpace(x.SerialTypeNoLot) ? "—" : x.SerialTypeNoLot)</dd></div><div><dt>Component 序號類型</dt><dd>@(string.IsNullOrWhiteSpace(x.SerialTypeNoComp) ? "—" : x.SerialTypeNoComp)</dd></div></dl></div>
<div class="detail-section section-separated"><div class="section-heading"><h3 id="product-processes">產品流程指派</h3><span>@Model.Processes.Count</span></div>@if (Model.Processes.Count == 0) { <p class="subtle-note">尚未指派流程；核准產品前至少需要一條預設流程。</p> } else { <div class="table-scroll"><table class="relation-table"><thead><tr><th>工單類型</th><th>製程段</th><th>流程</th><th>版本</th><th>預設</th>@if (x.IssueState == 0) { <th></th> }</tr></thead><tbody>@foreach (var p in Model.Processes) { <tr><td>@p.MoTypeNo</td><td>@p.ProductionSegmentNo</td><td>@p.ProcessNo</td><td>@p.ProcessVersionSelector</td><td>@(p.DefaultProcess ? "是" : "否")</td>@if (x.IssueState == 0) { <td><form asp-action="DeleteProductProcess" method="post"><input type="hidden" name="no" value="@x.ProductNo"/><input type="hidden" name="version" value="@x.ProductVersion"/><input type="hidden" name="moTypeNo" value="@p.MoTypeNo"/><input type="hidden" name="segment" value="@p.ProductionSegmentNo"/><input type="hidden" name="processNo" value="@p.ProcessNo"/><input type="hidden" name="selector" value="@p.ProcessVersionSelector"/><button class="link-danger" title="移除流程">移除</button></form></td> }</tr> }</tbody></table></div> }
@if (x.IssueState == 0) { <form asp-action="AddProductProcess" method="post" class="relation-form"><input type="hidden" name="no" value="@x.ProductNo"/><input type="hidden" name="version" value="@x.ProductVersion"/><label class="field"><span>工單類型</span><input name="request.MoTypeNo" type="number" value="10"/></label><label class="field"><span>製程段</span><select name="request.ProductionSegmentNo"><option>FRONT</option><option>BACK</option><option>ASSY</option></select></label><label class="field"><span>流程編號</span><select name="request.ProcessNo">@foreach (var p in Model.AvailableProcesses.Select(p => p.ProcessNo).Distinct()) { <option value="@p">@p</option> }</select></label><label class="field"><span>版本選擇</span><select name="request.ProcessVersionSelector"><option value="*">*（目前版本）</option>@foreach (var v in Model.AvailableProcesses.Select(p => p.ProcessVersion).Distinct()) { <option value="@v">@v（固定）</option> }</select></label><label class="check-field"><input name="request.DefaultProcess" type="checkbox" value="true" checked/><input name="request.DefaultProcess" type="hidden" value="false"/><span>預設流程</span></label><button class="button button-outline">加入流程</button></form> }
</div>
<div class="detail-section section-separated"><div class="section-heading"><h3 id="product-bom">產品 BOM</h3><span>@Model.Bom.Count</span></div>@if (Model.Bom.Count == 0) { <p class="subtle-note">尚未建立 BOM 項目。</p> } else { <div class="table-scroll"><table class="relation-table"><thead><tr><th>類型</th><th>Component</th><th>投入作業</th><th>標準用量</th>@if (x.IssueState == 0) { <th></th> }</tr></thead><tbody>@foreach (var b in Model.Bom) { <tr><td>@b.ComponentType</td><td>@b.ComponentNo</td><td>@b.InputOperationNo</td><td>@b.StandardQty.ToString("0.###")</td>@if (x.IssueState == 0) { <td><form asp-action="DeleteBom" method="post"><input type="hidden" name="no" value="@x.ProductNo"/><input type="hidden" name="version" value="@x.ProductVersion"/><input type="hidden" name="bomId" value="@b.Id"/><button class="link-danger">移除</button></form></td> }</tr> }</tbody></table></div> }
@if (x.IssueState == 0) { <form asp-action="AddBom" method="post" class="relation-form"><input type="hidden" name="no" value="@x.ProductNo"/><input type="hidden" name="version" value="@x.ProductVersion"/><label class="field"><span>Component 類型</span><select name="request.ComponentType"><option value="MATERIAL">物料</option><option value="PRODUCT">子產品</option></select></label><label class="field"><span>Component 編號</span><input name="request.ComponentNo" list="bomComponents" required/><datalist id="bomComponents">@foreach (var m in Model.AvailableMaterials) { <option value="@m.MaterialNo">@m.MaterialName</option> }@foreach (var p in Model.Items.Where(p => p.ProductNo != x.ProductNo)) { <option value="@p.ProductNo">@p.ProductName</option> }</datalist></label><label class="field"><span>投入作業</span><select name="request.InputOperationNo">@foreach (var o in Model.AvailableOperations) { <option value="@o.OperationNo">@o.OperationNo</option> }</select></label><label class="field"><span>標準用量</span><input name="request.StandardQty" type="number" min="0.000001" step="0.001" value="1"/></label><label class="field"><span>放置方式</span><input name="request.PutInPlaceType" value="At OP"/></label><label class="field"><span>損耗率 %</span><input name="request.DecreaseRate" type="number" min="0" max="100" step="0.1" value="0"/></label><button class="button button-outline">新增 BOM</button></form> }
</div><div class="detail-meta">建立於 @x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd") · DataStamp @x.DataStamp</div>
} else { <div class="no-selection"><div class="detail-symbol">◇</div><h2>選擇一個產品版本</h2><p>查看產品資料、流程指派與 BOM 組成。</p></div> }</aside></section>
