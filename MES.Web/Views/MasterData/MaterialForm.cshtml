@model MaterialWriteRequest
@{ var edit = Model.DataStamp > 0; ViewData["Title"] = edit ? "編輯物料" : "新增物料"; ViewData["ActiveMaster"] = "Materials"; var action = edit ? "EditMaterial" : "NewMaterial"; }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Materials">← 返回物料清單</a><div class="eyebrow">MATERIAL MANAGEMENT</div><h1>@(edit ? "編輯物料資料" : "新增物料")</h1><p>新建資料以 UNFROZEN 狀態建立，核准後供產品 BOM 使用。</p></div></div>
<form asp-action="@action" asp-route-id="@Model.MaterialNo" method="post" class="equipment-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="DataStamp" type="hidden"/>
<section class="form-card"><div class="form-card-heading"><span class="form-step">01</span><div><h2>物料識別與單位</h2><p>料號、分類、規格與庫存單位</p></div><span class="required-note"><i>*</i> 必填</span></div><div class="form-grid"><label class="field"><span>物料編號 <i>*</i></span><input asp-for="MaterialNo" readonly="@edit" placeholder="例如 MAT-ETCH-GAS"/><span asp-validation-for="MaterialNo" class="field-error"></span></label><label class="field"><span>物料類型 <i>*</i></span><input asp-for="MaterialType" placeholder="MATERIAL / CHEMICAL / PACKING"/><span asp-validation-for="MaterialType" class="field-error"></span></label><label class="field field-wide"><span>物料名稱 <i>*</i></span><input asp-for="MaterialName"/><span asp-validation-for="MaterialName" class="field-error"></span></label><label class="field field-wide"><span>規格</span><input asp-for="MaterialSpec"/></label><label class="field"><span>單位類型</span><input asp-for="UnitType" placeholder="PCS"/></label><label class="field"><span>庫存單位 <i>*</i></span><input asp-for="UnitNo"/><span asp-validation-for="UnitNo" class="field-error"></span></label><label class="field"><span>放置方式 <i>*</i></span><input asp-for="PutInPlace" placeholder="OP / WAREHOUSE"/><span asp-validation-for="PutInPlace" class="field-error"></span></label><label class="field"><span>ERP 編號</span><input asp-for="ErpNo"/></label><label class="field field-wide"><span>說明</span><textarea asp-for="Description" rows="3"></textarea></label></div></section>
<section class="form-card"><div class="form-card-heading"><span class="form-step">02</span><div><h2>庫存與效期管控</h2><p>定義補料警示、批號及開封後時限</p></div></div><div class="form-grid"><label class="field"><span>安全庫存</span><input asp-for="SafeQty" type="number" min="0" step="0.001"/></label><label class="field"><span>計數方式代碼</span><input asp-for="CountWay" type="number" min="0" max="9"/></label><label class="field"><span>批號檢查（0/1）</span><input asp-for="CheckLotNo" type="number" min="0" max="1"/></label><label class="field"><span>開封時限（小時）</span><input asp-for="OpenLimitTime" type="number" min="0" step="0.1"/></label><label class="check-field"><input asp-for="KeyMaterials"/><span>關鍵物料</span></label><label class="check-field"><input asp-for="OpenLimitTimeFlag"/><span>啟用開封時限</span></label><label class="check-field"><input asp-for="ResetOpenDate"/><span>重新開封時重設日期</span></label><label class="check-field"><input asp-for="ExpireDateFlag"/><span>啟用有效期限</span></label></div></section>
<div class="form-actions"><a class="button button-outline" asp-action="Materials">取消</a><button class="button button-primary" type="submit">儲存物料</button></div></form>
