@model ProductWriteRequest
@{ var edit = Model.DataStamp > 0; ViewData["Title"] = edit ? "編輯產品" : "新增產品"; ViewData["ActiveMaster"] = "Products"; var action = edit ? "EditProduct" : "NewProduct"; }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Products">← 返回產品清單</a><div class="eyebrow">PRODUCT MANAGEMENT</div><h1>@(edit ? "編輯產品資料" : "新增產品")</h1><p>新建產品版本會以 UNFROZEN 狀態建立；核准前需設定預設流程。</p></div></div>
<form asp-action="@action" asp-route-no="@Model.ProductNo" asp-route-version="@Model.ProductVersion" method="post" class="equipment-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="DataStamp" type="hidden"/>
<section class="form-card"><div class="form-card-heading"><span class="form-step">01</span><div><h2>產品識別與版本</h2><p>設定產品代碼、版本、類型與生產名稱</p></div></div><div class="form-grid"><label class="field"><span>產品編號 <i>*</i></span><input asp-for="ProductNo" readonly="@edit" placeholder="例如 PRD-3000"/><span asp-validation-for="ProductNo" class="field-error"></span></label><label class="field"><span>產品版本 <i>*</i></span><input asp-for="ProductVersion" readonly="@edit"/><span asp-validation-for="ProductVersion" class="field-error"></span></label><label class="field field-wide"><span>產品名稱 <i>*</i></span><input asp-for="ProductName"/><span asp-validation-for="ProductName" class="field-error"></span></label><label class="field"><span>產品類型 <i>*</i></span><input asp-for="ProductType" placeholder="PRODUCT / SUBPRODUCT"/><span asp-validation-for="ProductType" class="field-error"></span></label><label class="field"><span>Lot 標準量</span><input asp-for="LotStdQty" type="number" min="0" step="0.001"/></label><label class="field"><span>單位類型</span><input asp-for="UnitType" placeholder="PCS"/></label><label class="field"><span>庫存單位 <i>*</i></span><input asp-for="UnitNo"/><span asp-validation-for="UnitNo" class="field-error"></span></label><label class="field"><span>ERP 編號</span><input asp-for="ErpNo"/></label><label class="field"><span>規格編號</span><input asp-for="SpecNo"/></label><label class="field"><span>產品代碼</span><input asp-for="ProductCode"/></label><label class="field"><span>Lot 序號類型</span><input asp-for="SerialTypeNoLot"/></label><label class="field"><span>Component 序號類型</span><input asp-for="SerialTypeNoComp"/></label><label class="field field-wide"><span>說明</span><textarea asp-for="Description" rows="3"></textarea></label></div></section>
<div class="form-actions"><a class="button button-outline" asp-action="Products">取消</a><button class="button button-primary">儲存產品</button></div></form>
