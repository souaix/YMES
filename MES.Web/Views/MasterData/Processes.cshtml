@model ProcessIndexViewModel
@{
    ViewData["Title"] = "流程主檔"; ViewData["ActiveMaster"] = "Processes";
    string State(int s) => s switch { 0 => "UNFROZEN", 1 => "PENDING", 2 => "ACTIVE", -1 => "UNUSED", _ => "UNKNOWN" };
    string Css(int s) => s switch { 0 => "draft", 1 => "pending", 2 => "active", -1 => "unused", _ => "" };
}
<div class="page-heading"><div><div class="eyebrow">PROCESS ROUTE MANAGEMENT</div><h1>流程主檔</h1><p>管理流程版本、目前版本及流程節點/連線。</p></div><a class="button button-primary" asp-action="NewProcess">＋ 新增流程</a></div>
@await Html.PartialAsync("_Notice")
<section class="master-workspace"><div class="list-panel"><div class="panel-heading"><div><h2>流程版本清單</h2><span class="panel-subtitle">共 @Model.Items.Count 筆符合條件</span></div><span class="table-count">@Model.Items.Count ITEMS</span></div>
<form class="filter-bar" method="get" asp-action="Processes"><label class="search-box"><span>⌕</span><input type="search" name="keyword" value="@Model.Keyword" placeholder="搜尋流程編號、版本、類型" /></label><select name="issueState"><option value="">全部狀態</option><option value="2" selected="@(Model.IssueState == 2)">ACTIVE</option><option value="0" selected="@(Model.IssueState == 0)">UNFROZEN</option><option value="1" selected="@(Model.IssueState == 1)">PENDING</option><option value="-1" selected="@(Model.IssueState == -1)">UNUSED</option></select><button class="button button-filter">查詢</button></form>
<div class="table-scroll"><table class="equipment-table"><thead><tr><th>流程編號 / 版本</th><th>類型</th><th>製程段</th><th>分類</th><th>目前版</th><th>狀態</th></tr></thead><tbody>
@foreach (var row in Model.Items) { <tr class="@(Model.Selected?.ProcessNo == row.ProcessNo && Model.Selected?.ProcessVersion == row.ProcessVersion ? "selected-row" : "")" onclick="location.href='@Url.Action("Processes", new { keyword = Model.Keyword, issueState = Model.IssueState, no = row.ProcessNo, version = row.ProcessVersion })'"><td><span class="equipment-code">@row.ProcessNo <span class="version-tag">@row.ProcessVersion</span></span><span class="equipment-name">@row.Description</span></td><td><span class="type-chip">@row.ProcessType</span></td><td>@row.ProductionSegmentNo</td><td>@row.ProcessClass</td><td>@(row.CurrentVersion ? "●" : "—")</td><td><span class="status-pill @Css(row.IssueState)"><i></i>@State(row.IssueState)</span></td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-state">沒有符合條件的流程版本</td></tr> }
</tbody></table></div></div>
<aside class="detail-panel">@if (Model.Selected is { } x) { <div class="detail-header"><div class="detail-symbol">⤳</div><div class="detail-title"><span class="eyebrow">PROCESS DETAIL</span><h2>@x.ProcessNo / @x.ProcessVersion</h2><p>@x.Description</p></div><span class="status-pill @Css(x.IssueState)"><i></i>@State(x.IssueState)</span></div>
<div class="detail-actions">@if (x.IssueState == 0) { <a class="button button-outline" asp-action="EditProcess" asp-route-no="@x.ProcessNo" asp-route-version="@x.ProcessVersion">編輯主檔</a><a class="button button-outline" asp-action="EditGraph" asp-route-no="@x.ProcessNo" asp-route-version="@x.ProcessVersion">編輯節點</a><form asp-action="ApproveProcess" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProcessNo"/><input type="hidden" name="version" value="@x.ProcessVersion"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-primary">核准</button></form> }
@if (x.IssueState == 2) { <form asp-action="NewProcessVersion" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProcessNo"/><input type="hidden" name="version" value="@x.ProcessVersion"/><button class="button button-outline">複製新版本</button></form>@if (!x.CurrentVersion) { <form asp-action="SetCurrentProcess" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProcessNo"/><input type="hidden" name="version" value="@x.ProcessVersion"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-outline">設為目前版</button></form> } }
@if (x.IssueState is 0 or 2 or -1) { <form asp-action="DeleteProcess" method="post" class="inline-form" onsubmit="return confirm('確定刪除或停用 @x.ProcessNo/@x.ProcessVersion？')"><input type="hidden" name="no" value="@x.ProcessNo"/><input type="hidden" name="version" value="@x.ProcessVersion"/><input type="hidden" name="state" value="@x.IssueState"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-ghost-danger">@(x.IssueState == 2 ? "停用" : "刪除")</button></form> }</div>
<div class="detail-section"><div class="section-heading"><h3>版本設定</h3><span>@(x.CurrentVersion ? "CURRENT" : "REVISION")</span></div><dl class="detail-grid"><div><dt>流程類型</dt><dd>@x.ProcessType</dd></div><div><dt>製程段</dt><dd>@x.ProductionSegmentNo</dd></div><div><dt>流程分類</dt><dd>@x.ProcessClass</dd></div><div><dt>調機流程</dt><dd>@(x.TuningProcess ? "是" : "否")</dd></div><div><dt>Partial Type</dt><dd>@x.PartialType</dd></div><div><dt>目前版本</dt><dd>@(x.CurrentVersion ? "是" : "否")</dd></div></dl></div>
<div class="detail-section section-separated"><div class="section-heading"><h3>流程節點</h3><span>@(Model.Graph?.Nodes.Count ?? 0) NODES</span></div>@if (Model.Graph is { } graph) { <div class="route-list">@foreach (var node in graph.Nodes.OrderBy(n => n.Sequence)) { <div class="route-node"><span class="route-sequence">@node.Sequence.ToString("00")</span><span class="route-node-main"><strong>@node.NodeNo <small>@node.NodeType</small></strong><span>@node.Description</span></span><span class="route-op">@node.OperationNo</span></div> }</div><p class="subtle-note">節點間連線：@graph.Edges.Count 條；需修改時使用「編輯節點」。</p> }</div><div class="detail-meta">建立於 @x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd") · DataStamp @x.DataStamp</div>
} else { <div class="no-selection"><div class="detail-symbol">⤳</div><h2>選擇一個流程版本</h2><p>查看流程基本設定與節點順序。</p></div> }</aside></section>
