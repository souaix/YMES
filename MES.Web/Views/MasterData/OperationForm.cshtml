@model OperationWriteRequest
@{ var edit = Model.DataStamp > 0; ViewData["Title"] = edit ? "編輯作業" : "新增作業"; ViewData["ActiveMaster"] = "Operations"; var action = edit ? "EditOperation" : "NewOperation"; }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Operations">← 返回作業清單</a><div class="eyebrow">OPERATION DEFINITION</div><h1>@(edit ? "編輯作業定義" : "新增作業定義")</h1><p>新建資料會以 UNFROZEN 狀態建立；核准後可供流程節點引用。</p></div></div>
<form asp-action="@action" asp-route-id="@Model.OperationNo" method="post" class="equipment-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="DataStamp" type="hidden"/>
<section class="form-card"><div class="form-card-heading"><span class="form-step">01</span><div><h2>作業識別</h2><p>作業編號會被流程節點引用</p></div><span class="required-note"><i>*</i> 必填</span></div><div class="form-grid">
<label class="field"><span>作業編號 <i>*</i></span><input asp-for="OperationNo" readonly="@edit" placeholder="例如 OP-ETCH"/><span asp-validation-for="OperationNo" class="field-error"></span></label><label class="field"><span>作業類型 <i>*</i></span><input asp-for="OperationType" placeholder="例如 ETCH"/><span asp-validation-for="OperationType" class="field-error"></span></label><label class="field field-wide"><span>作業名稱 <i>*</i></span><input asp-for="OperationName"/><span asp-validation-for="OperationName" class="field-error"></span></label><label class="field"><span>作業分類</span><input asp-for="OperationClass" type="number" min="0" max="9"/></label><label class="field"><span>簡稱</span><input asp-for="ShortName"/></label><label class="field"><span>製程段 <i>*</i></span><input asp-for="ProductionSegmentNo" placeholder="FRONT / BACK / ASSY"/><span asp-validation-for="ProductionSegmentNo" class="field-error"></span></label><label class="field"><span>工序順序</span><input asp-for="OperationOrder" type="number"/></label><label class="field field-wide"><span>說明</span><textarea asp-for="Description" rows="3"></textarea></label></div></section>
<section class="form-card"><div class="form-card-heading"><span class="form-step">02</span><div><h2>製程與品質設定</h2><p>舊 MES 作業定義上的基本規則</p></div></div><div class="form-grid"><label class="field"><span>標準單位工時（分鐘）</span><input asp-for="StandardUnitRunTime" type="number" min="0" step="0.01"/></label><label class="field"><span>標準等待時間（分鐘）</span><input asp-for="StandardQueueTime" type="number" min="0" step="0.01"/></label><label class="field"><span>作業單位數量</span><input asp-for="CountOperationUnitQty" type="number" min="1"/></label><label class="field"><span>SPC 異常數量門檻</span><input asp-for="ErrorQtyToSpc" type="number" min="0" step="0.01"/></label><label class="check-field"><input asp-for="PrintOutOnRunCard"/><span>列印於 Run Card</span></label><label class="check-field"><input asp-for="SpcInspAbnormalHoldLot"/><span>SPC 檢驗異常時 Hold Lot</span></label><label class="field"><span>物料選項代碼</span><input asp-for="MaterialOption" type="number"/></label><label class="field"><span>多人作業模式代碼</span><input asp-for="MultiOperatorMode" type="number"/></label></div></section>
<div class="form-actions"><a class="button button-outline" asp-action="Operations">取消</a><button class="button button-primary" type="submit">儲存作業</button></div></form>
