@model OperationWriteRequest
@{ var edit = Model.DataStamp > 0; var isCopy = ViewData["IsCopy"] is true; var mode = edit ? "EDIT" : isCopy ? "COPY" : "ADD"; ViewData["Title"] = "作業站基本資料"; ViewData["ActiveMaster"] = "Operations"; var action = edit ? "EditOperation" : "NewOperation"; var operationTypes = ViewData["OperationTypes"] as string[] ?? Array.Empty<string>(); var productionSegments = ViewData["ProductionSegments"] as string[] ?? Array.Empty<string>(); }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Operations">← 返回作業清單</a><div class="eyebrow">OPERATION DEFINITION</div><h1>作業基本資料定義 (@mode)</h1><p>新建資料以未簽核狀態建立，核准後可供流程節點引用。</p></div></div>
<form asp-action="@action" asp-route-id="@Model.OperationNo" method="post" class="equipment-form winform-definition operation-definition">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="DataStamp" type="hidden"/><input asp-for="ErrorQtyToSpc" type="hidden"/><datalist id="operationTypes">@foreach (var value in operationTypes) { <option value="@value"></option> }</datalist><datalist id="operationSegments">@foreach (var value in productionSegments) { <option value="@value"></option> }</datalist>
<section class="form-card"><div class="form-card-heading"><span class="form-step">01</span><div><h2>作業識別</h2><p>作業編號會被流程節點引用</p></div><span class="required-note"><i>*</i> 必填</span></div><div class="form-grid">
<label class="field winform-key-field"><span>作業編號 <i>*</i></span><input asp-for="OperationNo" readonly="@edit" placeholder="例如 OP-ETCH"/><span asp-validation-for="OperationNo" class="field-error"></span></label><label class="field"><span>作業類別 <i>*</i></span><div class="winform-inline-field"><input asp-for="OperationType" list="operationTypes" readonly /><button class="lookup-button" type="button" data-focus-field="OperationType" aria-label="選擇作業類別">...</button></div><span asp-validation-for="OperationType" class="field-error"></span></label><label class="field field-wide winform-key-field"><span>作業名稱 <i>*</i></span><input asp-for="OperationName"/><span asp-validation-for="OperationName" class="field-error"></span></label><label class="field"><span>作業分類</span><input asp-for="OperationClass" type="number" min="0" max="9"/></label><label class="field"><span>簡稱</span><input asp-for="ShortName"/></label><label class="field"><span>製程段 <i>*</i></span><div class="winform-inline-field"><input asp-for="ProductionSegmentNo" list="operationSegments" readonly /><button class="lookup-button" type="button" data-focus-field="ProductionSegmentNo" aria-label="選擇製程段">...</button></div><span asp-validation-for="ProductionSegmentNo" class="field-error"></span></label><label class="field"><span>工序順序</span><input asp-for="OperationOrder" type="number"/></label><label class="field field-wide"><span>說明</span><textarea asp-for="Description" rows="3"></textarea></label></div></section>
<section class="form-card"><div class="form-card-heading"><span class="form-step">02</span><div><h2>製程與品質設定</h2><p>舊 MES 作業定義上的基本規則</p></div></div><div class="form-grid"><label class="field"><span>標準單位工時</span><input asp-for="StandardUnitRunTime" type="number" min="0" step="0.01"/></label><label class="field"><span>標準等待時間</span><input asp-for="StandardQueueTime" type="number" min="0" step="0.01"/></label><label class="field"><span>作業單位批量</span><input asp-for="CountOperationUnitQty" type="number" min="1"/></label><label class="check-field"><input asp-for="PrintOutOnRunCard"/><span>列印於 Run Card</span></label><label class="check-field"><input asp-for="SpcInspAbnormalHoldLot"/><span>SPC 檢驗異常時 Hold Lot</span></label><label class="field"><span>物料選項</span><input asp-for="MaterialOption" type="number"/></label><label class="field"><span>多人作業模式</span><input asp-for="MultiOperatorMode" type="number"/></label></div></section>
<div class="winform-audit"><label><span>建立人</span><input value="—" readonly /></label><label><span>建立日期</span><input value="@ViewData["CreatedAt"]" readonly /></label><label><span>修改人</span><input value="—" readonly /></label><label><span>修改日期</span><input value="@ViewData["RevisedAt"]" readonly /></label></div><div class="form-actions"><button class="button button-primary" type="submit">確定</button><a class="button button-outline" asp-action="Operations">關閉</a><button class="button" type="button" disabled>套用</button></div></form>
