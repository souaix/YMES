@model MaterialIndexViewModel
@{
    ViewData["Title"] = "物料主檔"; ViewData["ActiveMaster"] = "Materials";
    string State(int s) => s switch { 0 => "UNFROZEN", 1 => "PENDING", 2 => "ACTIVE", -1 => "UNUSED", _ => "UNKNOWN" };
    string Css(int s) => s switch { 0 => "draft", 1 => "pending", 2 => "active", -1 => "unused", _ => "" };
}
<div class="page-heading"><div><div class="eyebrow">MATERIAL MANAGEMENT</div><h1>物料主檔</h1><p>管理物料識別、庫存單位、安全庫存與效期管控。</p></div><a class="button button-primary" asp-action="NewMaterial">＋ 新增物料</a></div>
@await Html.PartialAsync("_Notice")
<section class="master-workspace"><div class="list-panel"><div class="panel-heading"><div><h2>物料清單</h2><span class="panel-subtitle">共 @Model.Items.Count 筆符合條件</span></div><span class="table-count">@Model.Items.Count ITEMS</span></div>
<form class="filter-bar" method="get" asp-action="Materials"><label class="search-box"><span>⌕</span><input type="search" name="keyword" value="@Model.Keyword" placeholder="搜尋編號、名稱、規格、類型" /></label><select name="issueState"><option value="">全部狀態</option><option value="2" selected="@(Model.IssueState == 2)">ACTIVE</option><option value="0" selected="@(Model.IssueState == 0)">UNFROZEN</option><option value="1" selected="@(Model.IssueState == 1)">PENDING</option><option value="-1" selected="@(Model.IssueState == -1)">UNUSED</option></select><button class="button button-filter">查詢</button></form>
<div class="table-scroll"><table class="equipment-table"><thead><tr><th>物料編號 / 名稱</th><th>類型</th><th>規格</th><th>單位</th><th>安全庫存</th><th>狀態</th></tr></thead><tbody>
@foreach (var row in Model.Items) { <tr class="@(Model.Selected?.MaterialNo == row.MaterialNo ? "selected-row" : "")" onclick="location.href='@Url.Action("Materials", new { keyword = Model.Keyword, issueState = Model.IssueState, selected = row.MaterialNo })'"><td><span class="equipment-code">@row.MaterialNo</span><span class="equipment-name">@row.MaterialName</span></td><td><span class="type-chip">@row.MaterialType</span></td><td>@(string.IsNullOrWhiteSpace(row.MaterialSpec) ? "—" : row.MaterialSpec)</td><td>@row.UnitNo</td><td>@row.SafeQty.ToString("0.###")</td><td><span class="status-pill @Css(row.IssueState)"><i></i>@State(row.IssueState)</span></td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-state">沒有符合條件的物料</td></tr> }
</tbody></table></div></div>
<aside class="detail-panel">@if (Model.Selected is { } x) { <div class="detail-header"><div class="detail-symbol">▤</div><div class="detail-title"><span class="eyebrow">MATERIAL DETAIL</span><h2>@x.MaterialNo</h2><p>@x.MaterialName</p></div><span class="status-pill @Css(x.IssueState)"><i></i>@State(x.IssueState)</span></div>
<div class="detail-actions">@if (x.IssueState == 0) { <a class="button button-outline" asp-action="EditMaterial" asp-route-id="@x.MaterialNo">編輯</a><form asp-action="ApproveMaterial" method="post" class="inline-form"><input type="hidden" name="no" value="@x.MaterialNo"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-primary">核准</button></form> }@if (x.IssueState is 0 or 2 or -1) { <form asp-action="DeleteMaterial" method="post" class="inline-form" onsubmit="return confirm('確定刪除或停用 @x.MaterialNo？')"><input type="hidden" name="no" value="@x.MaterialNo"/><input type="hidden" name="state" value="@x.IssueState"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-ghost-danger">@(x.IssueState == 2 ? "停用" : "刪除")</button></form> }</div>
<div class="detail-section"><div class="section-heading"><h3>物料與庫存</h3></div><dl class="detail-grid"><div><dt>物料類型</dt><dd>@x.MaterialType</dd></div><div><dt>規格</dt><dd>@(string.IsNullOrWhiteSpace(x.MaterialSpec) ? "—" : x.MaterialSpec)</dd></div><div><dt>單位類型</dt><dd>@x.UnitType</dd></div><div><dt>庫存單位</dt><dd>@x.UnitNo</dd></div><div><dt>放置方式</dt><dd>@x.PutInPlace</dd></div><div><dt>安全庫存</dt><dd>@x.SafeQty.ToString("0.###")</dd></div><div><dt>批號檢查</dt><dd>@(x.CheckLotNo == 1 ? "是" : "否")</dd></div><div><dt>關鍵物料</dt><dd>@(x.KeyMaterials ? "是" : "否")</dd></div><div><dt>開封時限</dt><dd>@(x.OpenLimitTimeFlag ? $"{x.OpenLimitTime} 小時" : "未啟用")</dd></div><div><dt>效期管控</dt><dd>@(x.ExpireDateFlag ? "是" : "否")</dd></div><div><dt>ERP 編號</dt><dd>@(string.IsNullOrWhiteSpace(x.ErpNo) ? "—" : x.ErpNo)</dd></div></dl></div><div class="detail-section section-separated"><div class="section-heading"><h3>說明</h3></div><p class="description-text">@(string.IsNullOrWhiteSpace(x.Description) ? "尚未填寫" : x.Description)</p></div><div class="detail-meta">建立於 @x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd") · DataStamp @x.DataStamp</div>
} else { <div class="no-selection"><div class="detail-symbol">▤</div><h2>選擇一筆物料</h2><p>查看物料單位、庫存與效期管控設定。</p></div> }</aside></section>
