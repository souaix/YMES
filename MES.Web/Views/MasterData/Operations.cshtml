@model OperationIndexViewModel
@{
    ViewData["Title"] = "作業站主檔"; ViewData["ActiveMaster"] = "Operations";
    string State(int s) => s switch { 0 => "UNFROZEN", 1 => "PENDING", 2 => "ACTIVE", -1 => "UNUSED", _ => "UNKNOWN" };
    string Css(int s) => s switch { 0 => "draft", 1 => "pending", 2 => "active", -1 => "unused", _ => "" };
}
<div class="page-heading"><div><div class="eyebrow">OPERATION DEFINITION</div><h1>作業站主檔</h1><p>維護可供流程節點引用的作業定義、製程段與標準工時。</p></div><a class="button button-primary" asp-action="NewOperation">＋ 新增作業</a></div>
@await Html.PartialAsync("_Notice")
<section class="master-workspace">
<div class="list-panel"><div class="panel-heading"><div><h2>作業清單</h2><span class="panel-subtitle">共 @Model.Items.Count 筆符合條件</span></div><span class="table-count">@Model.Items.Count ITEMS</span></div>
<form class="filter-bar" method="get" asp-action="Operations"><label class="search-box"><span>⌕</span><input type="search" name="keyword" value="@Model.Keyword" placeholder="搜尋編號、名稱、類型" /></label><select name="issueState"><option value="">全部狀態</option><option value="2" selected="@(Model.IssueState == 2)">ACTIVE</option><option value="0" selected="@(Model.IssueState == 0)">UNFROZEN</option><option value="1" selected="@(Model.IssueState == 1)">PENDING</option><option value="-1" selected="@(Model.IssueState == -1)">UNUSED</option></select><button class="button button-filter">查詢</button></form>
<div class="table-scroll"><table class="equipment-table"><thead><tr><th>作業編號 / 名稱</th><th>類型</th><th>製程段</th><th>工序</th><th>標準工時</th><th>狀態</th></tr></thead><tbody>
@foreach (var row in Model.Items) { <tr class="@(Model.Selected?.OperationNo == row.OperationNo ? "selected-row" : "")" onclick="location.href='@Url.Action("Operations", new { keyword = Model.Keyword, issueState = Model.IssueState, selected = row.OperationNo })'"><td><span class="equipment-code">@row.OperationNo</span><span class="equipment-name">@row.OperationName</span></td><td><span class="type-chip">@row.OperationType</span></td><td>@row.ProductionSegmentNo</td><td>@row.OperationOrder</td><td>@row.StandardUnitRunTime.ToString("0.##") min</td><td><span class="status-pill @Css(row.IssueState)"><i></i>@State(row.IssueState)</span></td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-state">沒有符合條件的作業定義</td></tr> }
</tbody></table></div></div>
<aside class="detail-panel">@if (Model.Selected is { } x) { <div class="detail-header"><div class="detail-symbol">⌖</div><div class="detail-title"><span class="eyebrow">OPERATION DETAIL</span><h2>@x.OperationNo</h2><p>@x.OperationName</p></div><span class="status-pill @Css(x.IssueState)"><i></i>@State(x.IssueState)</span></div>
<div class="detail-actions">@if (x.IssueState == 0) { <a class="button button-outline" asp-action="EditOperation" asp-route-id="@x.OperationNo">編輯</a><form asp-action="ApproveOperation" method="post" class="inline-form"><input type="hidden" name="no" value="@x.OperationNo"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-primary">核准</button></form> }@if (x.IssueState is 0 or 2 or -1) { <form asp-action="DeleteOperation" method="post" class="inline-form" onsubmit="return confirm('確定刪除或停用 @x.OperationNo？')"><input type="hidden" name="no" value="@x.OperationNo"/><input type="hidden" name="state" value="@x.IssueState"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-ghost-danger">@(x.IssueState == 2 ? "停用" : "刪除")</button></form> }</div>
<div class="detail-section"><div class="section-heading"><h3>基本資料</h3></div><dl class="detail-grid"><div><dt>作業類型</dt><dd>@x.OperationType</dd></div><div><dt>作業分類</dt><dd>@x.OperationClass</dd></div><div><dt>簡稱</dt><dd>@x.ShortName</dd></div><div><dt>製程段</dt><dd>@x.ProductionSegmentNo</dd></div><div><dt>工序</dt><dd>@x.OperationOrder</dd></div><div><dt>單位數量</dt><dd>@x.CountOperationUnitQty</dd></div><div><dt>標準工時</dt><dd>@x.StandardUnitRunTime 分</dd></div><div><dt>標準等待時間</dt><dd>@x.StandardQueueTime 分</dd></div><div><dt>Run Card 列印</dt><dd>@(x.PrintOutOnRunCard ? "是" : "否")</dd></div><div><dt>SPC 異常 Hold</dt><dd>@(x.SpcInspAbnormalHoldLot ? "是" : "否")</dd></div></dl></div><div class="detail-section section-separated"><div class="section-heading"><h3>說明</h3></div><p class="description-text">@(string.IsNullOrWhiteSpace(x.Description) ? "尚未填寫" : x.Description)</p></div><div class="detail-meta">建立於 @x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd") · DataStamp @x.DataStamp</div>
} else { <div class="no-selection"><div class="detail-symbol">⌖</div><h2>選擇一筆作業</h2><p>查看作業定義與標準工時。</p></div> }</aside></section>
