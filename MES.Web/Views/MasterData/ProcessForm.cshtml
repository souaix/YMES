@model ProcessWriteRequest
@{ var edit = Model.DataStamp > 0; ViewData["Title"] = edit ? "編輯流程" : "新增流程"; ViewData["ActiveMaster"] = "Processes"; var action = edit ? "EditProcess" : "NewProcess"; }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Processes">← 返回流程清單</a><div class="eyebrow">PROCESS ROUTE</div><h1>@(edit ? "編輯流程主檔" : "新增流程主檔")</h1><p>流程建立後可在節點編輯器設定 START、作業節點、END 與連線。</p></div></div>
<form asp-action="@action" asp-route-no="@Model.ProcessNo" asp-route-version="@Model.ProcessVersion" method="post" class="equipment-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="DataStamp" type="hidden"/>
<section class="form-card"><div class="form-card-heading"><span class="form-step">01</span><div><h2>流程識別與版本</h2><p>流程編號可有多個版本，ACTIVE 版本可被產品引用</p></div></div><div class="form-grid"><label class="field"><span>流程編號 <i>*</i></span><input asp-for="ProcessNo" readonly="@edit" placeholder="例如 PR-ETCH"/><span asp-validation-for="ProcessNo" class="field-error"></span></label><label class="field"><span>流程版本 <i>*</i></span><input asp-for="ProcessVersion" readonly="@edit"/><span asp-validation-for="ProcessVersion" class="field-error"></span></label><label class="field"><span>流程類型 <i>*</i></span><input asp-for="ProcessType" placeholder="例如 PRODUCTION"/><span asp-validation-for="ProcessType" class="field-error"></span></label><label class="field"><span>製程段 <i>*</i></span><input asp-for="ProductionSegmentNo" placeholder="FRONT / BACK / ASSY"/><span asp-validation-for="ProductionSegmentNo" class="field-error"></span></label><label class="field"><span>流程分類</span><input asp-for="ProcessClass" type="number" min="0" max="9"/></label><label class="field"><span>Partial Type</span><input asp-for="PartialType" type="number"/></label><label class="check-field"><input asp-for="TuningProcess"/><span>調機流程</span></label><label class="field field-wide"><span>說明</span><textarea asp-for="Description" rows="3"></textarea></label></div></section>
<div class="form-actions"><a class="button button-outline" asp-action="Processes">取消</a><button class="button button-primary">儲存流程</button></div></form>
