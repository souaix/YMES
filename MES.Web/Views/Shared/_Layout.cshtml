<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YMES</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/legacy-mes.css" asp-append-version="true" />
</head>
<body>
@{
    var activeMaster = ViewData["ActiveMaster"]?.ToString() ?? "Equipment";
}
<div class="app-shell">
    <aside class="sidebar winform-sidebar">
        <div class="menu-tabs" role="tablist" aria-label="功能選單">
            <button class="menu-tab active" type="button" role="tab" aria-selected="true" data-menu-tab="functions"><span>☰</span>功能選單</button>
            <button class="menu-tab" type="button" role="tab" aria-selected="false" data-menu-tab="flow"><span>⌘</span>流程選單</button>
            <button class="menu-tab" type="button" role="tab" aria-selected="false" data-menu-tab="favorites"><span>♡</span>我的最愛</button>
        </div>
        <div class="menu-panel" data-menu-panel="functions">
            <div class="menu-search"><button type="button" class="menu-back" aria-label="返回">←</button><input type="search" placeholder="搜尋功能" data-menu-search /></div>
            <nav class="winform-menu" aria-label="主檔功能">
                <div class="menu-category">設備資料</div>
                <a class="nav-item @(activeMaster == "Equipment" ? "active" : "")" asp-controller="Equipment" asp-action="Index" data-menu-item><span class="nav-icon">♙</span>設備基本資料</a>
                <div class="menu-category">製程資料</div>
                <a class="nav-item @(activeMaster == "Operations" ? "active" : "")" asp-controller="MasterData" asp-action="Operations" data-menu-item><span class="nav-icon">▣</span>作業站基本資料</a>
                <a class="nav-item @(activeMaster == "Processes" ? "active" : "")" asp-controller="MasterData" asp-action="Processes" data-menu-item><span class="nav-icon">⤳</span>流程基本資料</a>
                <div class="menu-category">物料與產品</div>
                <a class="nav-item @(activeMaster == "Materials" ? "active" : "")" asp-controller="MasterData" asp-action="Materials" data-menu-item><span class="nav-icon">▤</span>物料基本資料</a>
                <a class="nav-item @(activeMaster == "Products" ? "active" : "")" asp-controller="MasterData" asp-action="Products" data-menu-item><span class="nav-icon">◇</span>產品基本資料</a>
            </nav>
        </div>
        <div class="menu-panel" data-menu-panel="flow" hidden>
            <div class="menu-search"><button type="button" class="menu-back" aria-label="返回">←</button><span class="menu-panel-title">流程相關功能</span></div>
            <nav class="winform-menu"><a class="nav-item @(activeMaster == "Processes" ? "active" : "")" asp-controller="MasterData" asp-action="Processes"><span class="nav-icon">⤳</span>流程基本資料</a><a class="nav-item @(activeMaster == "Operations" ? "active" : "")" asp-controller="MasterData" asp-action="Operations"><span class="nav-icon">▣</span>作業站基本資料</a><a class="nav-item @(activeMaster == "Products" ? "active" : "")" asp-controller="MasterData" asp-action="Products"><span class="nav-icon">◇</span>產品流程設定</a></nav>
        </div>
        <div class="menu-panel" data-menu-panel="favorites" hidden>
            <div class="menu-search"><button type="button" class="menu-back" aria-label="返回">←</button><span class="menu-panel-title">我的最愛</span></div>
            <nav class="winform-menu"><a class="nav-item @(activeMaster == "Equipment" ? "active" : "")" asp-controller="Equipment" asp-action="Index"><span class="nav-icon">♡</span>設備基本資料</a><a class="nav-item @(activeMaster == "Operations" ? "active" : "")" asp-controller="MasterData" asp-action="Operations"><span class="nav-icon">♡</span>作業站基本資料</a><a class="nav-item @(activeMaster == "Materials" ? "active" : "")" asp-controller="MasterData" asp-action="Materials"><span class="nav-icon">♡</span>物料基本資料</a><a class="nav-item @(activeMaster == "Processes" ? "active" : "")" asp-controller="MasterData" asp-action="Processes"><span class="nav-icon">♡</span>流程基本資料</a><a class="nav-item @(activeMaster == "Products" ? "active" : "")" asp-controller="MasterData" asp-action="Products"><span class="nav-icon">♡</span>產品基本資料</a></nav>
        </div>
        <div class="sidebar-bottom"><span class="brand-mark">S</span><span><strong>YMES</strong><small>WEB UI · API</small></span></div>
    </aside>
    <main class="main-shell"><div class="page-content">@RenderBody()</div></main>
</div>
<script src="~/js/legacy-mes.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>