@model ProcessGraphPageModel
@{ ViewData["Title"] = $"流程節點：{Model.Process.ProcessNo} / {Model.Process.ProcessVersion}"; ViewData["ActiveMaster"] = "Processes"; }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Processes" asp-route-no="@Model.Process.ProcessNo" asp-route-version="@Model.Process.ProcessVersion">← 返回流程主檔</a><h1>流程節點設定　@Model.Process.ProcessNo / @Model.Process.ProcessVersion</h1></div></div>
<form asp-action="EditGraph" asp-route-no="@Model.Process.ProcessNo" asp-route-version="@Model.Process.ProcessVersion" method="post" class="equipment-form process-graph-form" data-process-graph>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" name="dataStamp" value="@Model.Graph.DataStamp" />
    <input type="hidden" name="nodesJson" value="@Model.NodesJson" data-nodes-json />
    <input type="hidden" name="edgesJson" value="@Model.EdgesJson" data-edges-json />
    <section class="form-card">
        <div class="form-card-heading"><h2>流程節點</h2></div>
        <div class="graph-flow-preview" data-flow-preview aria-label="流程順序預覽"></div>
        <div class="graph-toolbar"><button type="button" class="winform-button" data-add-node>新增節點</button></div>
        <div class="table-scroll"><table class="equipment-table"><thead><tr><th>順序</th><th>節點編號</th><th>節點類型</th><th>作業站編號</th><th>說明</th><th>操作</th></tr></thead><tbody data-node-rows></tbody></table></div>
    </section>
    <section class="form-card">
        <div class="form-card-heading"><h2>節點連線</h2></div>
        <div class="graph-toolbar"><button type="button" class="winform-button" data-add-edge>新增連線</button></div>
        <div class="table-scroll"><table class="equipment-table"><thead><tr><th>起點節點</th><th>終點節點</th><th>轉換條件</th><th>操作</th></tr></thead><tbody data-edge-rows></tbody></table></div>
        <p class="json-hint">起點與終點必須選取現有節點；OP 節點必須指定已核准的作業站。</p>
    </section>
    <div class="form-actions"><a class="button button-outline" asp-action="Processes" asp-route-no="@Model.Process.ProcessNo" asp-route-version="@Model.Process.ProcessVersion">關閉</a><button class="button button-primary" type="submit">確定</button><button class="button" type="button" disabled>套用</button></div>
</form>