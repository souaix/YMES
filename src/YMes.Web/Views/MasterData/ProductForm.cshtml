@model ProductWriteRequest
@{ var edit = ViewData["IsEdit"] is true; var isCopy = ViewData["IsCopy"] is true; var mode = edit ? "EDIT" : isCopy ? "COPY" : "ADD"; ViewData["Title"] = "產品基本資料"; ViewData["ActiveMaster"] = "Products"; var action = edit ? "EditProduct" : "NewProduct"; var productTypes = ViewData["ProductTypes"] as string[] ?? Array.Empty<string>(); var unitTypes = ViewData["UnitTypes"] as string[] ?? Array.Empty<string>(); var unitNos = ViewData["UnitNos"] as string[] ?? Array.Empty<string>(); var lotSerialTypes = ViewData["SerialTypesLot"] as string[] ?? Array.Empty<string>(); var compSerialTypes = ViewData["SerialTypesComp"] as string[] ?? Array.Empty<string>(); }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Products">← 返回產品清單</a><div class="eyebrow">PRODUCT MANAGEMENT</div><h1>產品基本資料定義 (@mode)</h1><p>新建產品版本會以 UNFROZEN 狀態建立；核准前需設定預設流程。</p></div></div>
<form asp-action="@action" asp-route-no="@Model.ProductNo" asp-route-version="@Model.ProductVersion" method="post" class="equipment-form winform-definition product-definition">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="IssueState" type="hidden"/><input asp-for="DataStamp" type="hidden"/><datalist id="productTypes">@foreach (var value in productTypes) { <option value="@value"></option> }</datalist><datalist id="unitTypes">@foreach (var value in unitTypes) { <option value="@value"></option> }</datalist><datalist id="unitNos">@foreach (var value in unitNos) { <option value="@value"></option> }</datalist><datalist id="lotSerialTypes">@foreach (var value in lotSerialTypes) { <option value="@value"></option> }</datalist><datalist id="compSerialTypes">@foreach (var value in compSerialTypes) { <option value="@value"></option> }</datalist>
<section class="form-card"><div class="form-card-heading"><span class="form-step">01</span><div><h2>產品識別與版本</h2><p>設定產品代碼、版本、類型與生產名稱</p></div></div><div class="form-grid"><label class="field winform-key-field"><span>產品編號 <i>*</i></span><input asp-for="ProductNo" readonly="@edit" placeholder="例如 PRD-3000"/><span asp-validation-for="ProductNo" class="field-error"></span></label><label class="field"><span>產品版本 <i>*</i></span><input asp-for="ProductVersion" readonly="@edit"/><span asp-validation-for="ProductVersion" class="field-error"></span></label><label class="field field-wide winform-key-field"><span>產品名稱 <i>*</i></span><input asp-for="ProductName"/><span asp-validation-for="ProductName" class="field-error"></span></label><label class="field"><span>產品類別 <i>*</i></span><div class="winform-inline-field"><input asp-for="ProductType" list="productTypes" /><button class="lookup-button" type="button" data-focus-field="ProductType" aria-label="選擇產品類別">...</button></div><span asp-validation-for="ProductType" class="field-error"></span></label><div class="field"><span>Lot 標準量</span><div class="product-lot-qty"><label><input type="radio" name="LotStdQtyMode" value="standard" checked="@(Model.LotStdQty > 0)" data-lot-qty-mode/>標準量</label><input asp-for="LotStdQty" type="number" min="0" step="0.001" data-lot-qty/><label><input type="radio" name="LotStdQtyMode" value="none" checked="@(Model.LotStdQty <= 0)" data-lot-qty-mode/>不設定</label></div></div><label class="field"><span>單位類型</span><div class="winform-inline-field"><input asp-for="UnitType" list="unitTypes" /><button class="lookup-button" type="button" data-focus-field="UnitType" aria-label="選擇單位類型">...</button></div></label><label class="field"><span>庫存單位 <i>*</i></span><div class="winform-inline-field"><input asp-for="UnitNo" list="unitNos" /><button class="lookup-button" type="button" data-focus-field="UnitNo" aria-label="選擇庫存單位">...</button></div><span asp-validation-for="UnitNo" class="field-error"></span></label><label class="field"><span>ERP 編號</span><input asp-for="ErpNo"/></label><label class="field"><span>規格編號</span><input asp-for="SpecNo"/></label><label class="field"><span>產品代碼</span><input asp-for="ProductCode"/></label><label class="field"><span>Lot 序號類型</span><div class="winform-inline-field"><input asp-for="SerialTypeNoLot" list="lotSerialTypes" /><button class="lookup-button" type="button" data-focus-field="SerialTypeNoLot" aria-label="選擇 Lot 序號類型">...</button></div></label><label class="field"><span>Component 序號類型</span><div class="winform-inline-field"><input asp-for="SerialTypeNoComp" list="compSerialTypes" /><button class="lookup-button" type="button" data-focus-field="SerialTypeNoComp" aria-label="選擇 Component 序號類型">...</button></div></label><label class="field"><span>SAP_PLNAL</span><select asp-for="SapPlnal"><option value="">(未設定／保留現值)</option>@if (!string.IsNullOrEmpty(Model.SapPlnal) && !new[] { "11", "21", "51", "31", "61" }.Contains(Model.SapPlnal)) { <option value="@Model.SapPlnal">@(Model.SapPlnal)（原值）</option> }<option value="11">Homemade_自製</option><option value="21">Partial Process Outsourcing_半委</option><option value="51">Whole Process Outsourcing_全製程委外</option><option value="31">Rework_重工</option><option value="61">Total Outsource Rework_重工全委</option></select><span asp-validation-for="SapPlnal" class="field-error"></span></label><label class="field field-wide"><span>說明</span><textarea asp-for="Description" rows="3"></textarea></label></div></section>
<div class="winform-audit"><label><span>建立人</span><input value="—" readonly /></label><label><span>建立日期</span><input value="@ViewData["CreatedAt"]" readonly /></label><label><span>修改人</span><input value="—" readonly /></label><label><span>修改日期</span><input value="@ViewData["RevisedAt"]" readonly /></label></div><div class="form-actions"><button class="button button-primary" type="submit">確定</button><a class="button button-outline" asp-action="Products">關閉</a><button class="button" type="button" disabled>套用</button></div></form>
