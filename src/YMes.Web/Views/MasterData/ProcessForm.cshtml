@model ProcessWriteRequest
@{ var edit = Model.DataStamp > 0; var isCopy = ViewData["IsCopy"] is true; var mode = edit ? "EDIT" : isCopy ? "COPY" : "ADD"; ViewData["Title"] = "流程基本資料"; ViewData["ActiveMaster"] = "Processes"; var action = edit ? "EditProcess" : "NewProcess"; var processTypes = ViewData["ProcessTypes"] as string[] ?? Array.Empty<string>(); var productionSegments = ViewData["ProductionSegments"] as string[] ?? Array.Empty<string>(); }
<div class="page-heading form-heading"><div><a class="back-link" asp-action="Processes">← 返回流程清單</a><div class="eyebrow">PROCESS ROUTE</div><h1>流程基本資料定義 (@mode)</h1><p>流程建立後可在節點編輯器設定 START、作業節點、END 與連線。</p></div></div>
<form asp-action="@action" asp-route-no="@Model.ProcessNo" asp-route-version="@Model.ProcessVersion" method="post" class="equipment-form winform-definition process-definition">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="DataStamp" type="hidden"/><datalist id="processTypes">@foreach (var value in processTypes) { <option value="@value"></option> }</datalist><datalist id="processSegments">@foreach (var value in productionSegments) { <option value="@value"></option> }</datalist>
<section class="form-card"><div class="form-card-heading"><span class="form-step">01</span><div><h2>流程識別與版本</h2><p>流程編號可有多個版本，ACTIVE 版本可被產品引用</p></div></div><div class="form-grid"><label class="field winform-key-field"><span>流程編號 <i>*</i></span><input asp-for="ProcessNo" readonly="@edit" placeholder="例如 PR-ETCH"/><span asp-validation-for="ProcessNo" class="field-error"></span></label><label class="field"><span>流程版本 <i>*</i></span><input asp-for="ProcessVersion" readonly="@edit"/><span asp-validation-for="ProcessVersion" class="field-error"></span></label><label class="field"><span>流程類別 <i>*</i></span><div class="winform-inline-field"><input asp-for="ProcessType" list="processTypes" /><button class="lookup-button" type="button" data-focus-field="ProcessType" aria-label="選擇流程類別">...</button></div><span asp-validation-for="ProcessType" class="field-error"></span></label><label class="field"><span>製程段 <i>*</i></span><div class="winform-inline-field"><input asp-for="ProductionSegmentNo" list="processSegments" /><button class="lookup-button" type="button" data-focus-field="ProductionSegmentNo" aria-label="選擇製程段">...</button></div><span asp-validation-for="ProductionSegmentNo" class="field-error"></span></label><label class="field"><span>流程分類</span><input asp-for="ProcessClass" type="number" min="0" max="9"/></label><label class="field"><span>Partial 類型</span><input asp-for="PartialType" type="number"/></label><label class="check-field"><input asp-for="TuningProcess"/><span>調機流程</span></label><label class="field field-wide"><span>說明</span><textarea asp-for="Description" rows="3"></textarea></label></div></section>
<div class="winform-audit"><label><span>建立人</span><input value="—" readonly /></label><label><span>建立日期</span><input value="@ViewData["CreatedAt"]" readonly /></label><label><span>修改人</span><input value="—" readonly /></label><label><span>修改日期</span><input value="@ViewData["RevisedAt"]" readonly /></label></div><div class="form-actions"><button class="button button-primary" type="submit">確定</button><a class="button button-outline" asp-action="Processes">關閉</a><button class="button" type="button" disabled>套用</button></div></form>
