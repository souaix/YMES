@model OperationIndexViewModel
@{
    ViewData["Title"] = "作業站主檔"; ViewData["ActiveMaster"] = "Operations";
    string State(int s) => s switch { 0 => "UNFROZEN", 1 => "PENDING", 2 => "ACTIVE", -1 => "UNUSED", _ => "UNKNOWN" };
    string Css(int s) => s switch { 0 => "draft", 1 => "pending", 2 => "active", -1 => "unused", _ => "" };
}
<div class="page-heading winform-page-heading"><div><div class="eyebrow">OPERATION DEFINITION</div><h1>作業站主檔</h1><p>維護可供流程節點引用的作業定義、製程段與標準工時。</p><span class="winform-screen-code">WinForms 對照：frmOPBasis</span></div><a class="button button-primary" asp-action="NewOperation">＋ 新增作業</a></div>
@await Html.PartialAsync("_Notice")
<section class="master-workspace winform-workspace">
<div class="list-panel"><div class="panel-heading"><div><h2>作業清單</h2><span class="panel-subtitle">共 @Model.Items.Count 筆符合條件</span></div><span class="table-count">@Model.Items.Count ITEMS</span></div>
<form class="filter-bar winform-query" method="get" asp-action="Operations">
@await Html.PartialAsync("_WinFormIssueStateFilter", Model.IssueState)
<span class="winform-search-label">作業站</span><select name="searchField" aria-label="查詢欄位"><option value="OperationNo">作業編號</option></select>
<label class="search-box"><input type="search" name="keyword" value="@Model.Keyword" aria-label="作業編號" /></label><span class="winform-like">%</span>
<button class="button button-filter" type="submit">查詢</button></form>
<div class="winform-function-bar" role="toolbar" aria-label="作業站主檔功能"><span class="winform-function-title">FUNCTION</span>
<a class="winform-button winform-button-primary" asp-action="NewOperation">新增作業 (A)</a>
@if (Model.Selected is { } actionItem)
{
    @if (actionItem.IssueState == 0) { <a class="winform-button" asp-action="EditOperation" asp-route-id="@actionItem.OperationNo">修改 (E)</a><form asp-action="ApproveOperation" method="post" class="winform-command-form"><input type="hidden" name="no" value="@actionItem.OperationNo" /><input type="hidden" name="stamp" value="@actionItem.DataStamp" /><button class="winform-button">核准</button></form> }
    @if (actionItem.IssueState is 0 or 2 or -1) { <form asp-action="DeleteOperation" method="post" class="winform-command-form" onsubmit="return confirm('確定刪除或停用 @actionItem.OperationNo？');"><input type="hidden" name="no" value="@actionItem.OperationNo" /><input type="hidden" name="state" value="@actionItem.IssueState" /><input type="hidden" name="stamp" value="@actionItem.DataStamp" /><button class="winform-button winform-button-danger">@(actionItem.IssueState == 2 ? "停用" : "刪除")</button></form> }
}
@if (Model.Selected is { } copyItem) { <a class="winform-button" asp-action="CopyOperation" asp-route-id="@copyItem.OperationNo">複製(C)</a> }
<button class="winform-button" type="button" disabled title="作業屬性 API 尚未提供">屬性</button><button class="winform-button" type="button" disabled title="作業資源 API 尚未提供">資源</button><button class="winform-button" type="button" disabled title="商業規則 API 尚未提供">商業規則</button><button class="winform-button" type="button" disabled title="作業參數 API 尚未提供">參數</button><button class="winform-button" type="button" disabled title="QC 項目 API 尚未提供">QC 項目</button><button class="winform-button" type="button" disabled title="錯誤設定 API 尚未提供">錯誤設定</button><button class="winform-button" type="button" disabled title="異常設定 API 尚未提供">異常設定</button><button class="winform-button" type="button" disabled title="Recipe Temp API 尚未提供">Recipe Temp</button><button class="winform-button" type="button" disabled title="作業資料複製 API 尚未提供">複製作業資料</button><button class="winform-button" type="button" disabled title="子作業 API 尚未提供">子作業</button><button class="winform-button" type="button" disabled title="作業匯入 API 尚未提供">匯入</button><button class="winform-button" type="button" data-export-csv data-filename="operations.csv">Download</button><button class="winform-button" type="button" data-print>Print</button><a class="winform-button" href="#" data-close-window>關閉</a>
<span class="winform-toolbar-separator"></span><span class="winform-selection">符合 @Model.Items.Count 筆；選取 @(Model.Selected?.OperationNo ?? "—")</span></div>
<div class="table-scroll"><table class="equipment-table master-list-table"><thead><tr><th>作業編號</th><th>作業名稱</th><th>簡稱</th><th>作業類型</th><th>作業分類</th><th>製程段</th><th>工序順序</th><th>作業單位數量</th><th>標準單位工時</th><th>標準等待時間</th><th>物料選項</th><th>多人作業模式</th><th>Run Card 列印</th><th>SPC 異常 Hold Lot</th><th>SPC 數量門檻</th></tr></thead><tbody>
@foreach (var row in Model.Items)
{
    <tr class="@(Model.Selected?.OperationNo == row.OperationNo ? "selected-row" : "")" onclick="location.href='@Url.Action("Operations", new { keyword = Model.Keyword, issueState = Model.IssueState, selected = row.OperationNo })'"><td class="equipment-code">@row.OperationNo</td><td>@row.OperationName</td><td>@row.ShortName</td><td>@row.OperationType</td><td>@row.OperationClass</td><td>@row.ProductionSegmentNo</td><td>@row.OperationOrder</td><td>@row.CountOperationUnitQty</td><td>@row.StandardUnitRunTime.ToString("0.##")</td><td>@row.StandardQueueTime.ToString("0.##")</td><td>@row.MaterialOption</td><td>@row.MultiOperatorMode</td><td>@(row.PrintOutOnRunCard ? "Y" : "N")</td><td>@(row.SpcInspAbnormalHoldLot ? "Y" : "N")</td><td>@row.ErrorQtyToSpc</td></tr>
}
@if (Model.Items.Count == 0) { <tr><td colspan="15" class="empty-state">沒有符合條件的作業定義</td></tr> }
</tbody></table></div><div class="list-footer">資料總筆數 <strong>@Model.Items.Count</strong></div></div>
<aside class="detail-panel">@if (Model.Selected is { } x) { <div class="detail-header"><div class="detail-symbol">⌖</div><div class="detail-title"><span class="eyebrow">OPERATION DETAIL</span><h2>@x.OperationNo</h2><p>@x.OperationName</p></div><span class="status-pill @Css(x.IssueState)"><i></i>@State(x.IssueState)</span></div>
<div class="detail-actions">@if (x.IssueState == 0) { <a class="button button-outline" asp-action="EditOperation" asp-route-id="@x.OperationNo">編輯</a><form asp-action="ApproveOperation" method="post" class="inline-form"><input type="hidden" name="no" value="@x.OperationNo"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-primary">核准</button></form> }@if (x.IssueState is 0 or 2 or -1) { <form asp-action="DeleteOperation" method="post" class="inline-form" onsubmit="return confirm('確定刪除或停用 @x.OperationNo？')"><input type="hidden" name="no" value="@x.OperationNo"/><input type="hidden" name="state" value="@x.IssueState"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-ghost-danger">@(x.IssueState == 2 ? "停用" : "刪除")</button></form> }</div>
<div class="detail-section"><div class="section-heading"><h3>基本資料</h3></div><dl class="detail-grid"><div><dt>作業類型</dt><dd>@x.OperationType</dd></div><div><dt>作業分類</dt><dd>@x.OperationClass</dd></div><div><dt>簡稱</dt><dd>@x.ShortName</dd></div><div><dt>製程段</dt><dd>@x.ProductionSegmentNo</dd></div><div><dt>工序</dt><dd>@x.OperationOrder</dd></div><div><dt>單位數量</dt><dd>@x.CountOperationUnitQty</dd></div><div><dt>標準工時</dt><dd>@x.StandardUnitRunTime 分</dd></div><div><dt>標準等待時間</dt><dd>@x.StandardQueueTime 分</dd></div><div><dt>Run Card 列印</dt><dd>@(x.PrintOutOnRunCard ? "是" : "否")</dd></div><div><dt>SPC 異常 Hold</dt><dd>@(x.SpcInspAbnormalHoldLot ? "是" : "否")</dd></div></dl></div><div class="detail-section section-separated"><div class="section-heading"><h3>說明</h3></div><p class="description-text">@(string.IsNullOrWhiteSpace(x.Description) ? "尚未填寫" : x.Description)</p></div><div class="detail-meta">建立於 @(x.CreatedAt?.ToLocalTime().ToString("yyyy/MM/dd") ?? "—") · DataStamp @x.DataStamp</div>
} else { <div class="no-selection"><div class="detail-symbol">⌖</div><h2>選擇一筆作業</h2><p>查看作業定義與標準工時。</p></div> }</aside></section>
