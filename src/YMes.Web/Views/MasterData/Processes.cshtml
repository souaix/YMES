@model ProcessIndexViewModel
@{
    ViewData["Title"] = "流程主檔"; ViewData["ActiveMaster"] = "Processes";
    string State(int s) => s switch { 0 => "UNFROZEN", 1 => "PENDING", 2 => "ACTIVE", -1 => "UNUSED", _ => "UNKNOWN" };
    string Css(int s) => s switch { 0 => "draft", 1 => "pending", 2 => "active", -1 => "unused", _ => "" };
}
<div class="page-heading winform-page-heading"><div><div class="eyebrow">PROCESS ROUTE MANAGEMENT</div><h1>流程主檔</h1><p>管理流程版本、目前版本及流程節點/連線。</p><span class="winform-screen-code">WinForms 對照：frmProcessBasis</span></div><a class="button button-primary" asp-action="NewProcess">＋ 新增流程</a></div>
@await Html.PartialAsync("_Notice")
<section class="master-workspace winform-workspace"><div class="list-panel"><div class="panel-heading"><div><h2>流程版本清單</h2><span class="panel-subtitle">共 @Model.Items.Count 筆符合條件</span></div><span class="table-count">@Model.Items.Count ITEMS</span></div>
<form class="filter-bar winform-query" method="get" asp-action="Processes">
@await Html.PartialAsync("_WinFormIssueStateFilter", Model.IssueState)
<span class="winform-search-label">流程</span><select name="searchField" aria-label="查詢欄位"><option value="ProcessNo">流程編號</option></select>
<label class="search-box"><input type="search" name="keyword" value="@Model.Keyword" aria-label="流程編號" /></label><span class="winform-like">%</span>
<button class="button button-filter" type="submit">查詢</button></form>
<div class="winform-function-bar" role="toolbar" aria-label="流程主檔功能"><span class="winform-function-title">FUNCTION</span>
<a class="winform-button winform-button-primary" asp-action="NewProcess">新增流程 (A)</a>
@if (Model.Selected is { } copyItem) { <a class="winform-button" asp-action="CopyProcess" asp-route-no="@copyItem.ProcessNo" asp-route-version="@copyItem.ProcessVersion">複製(C)</a> }
@if (Model.Selected is { } actionItem)
{
    @if (actionItem.IssueState == 0) { <a class="winform-button" asp-action="EditProcess" asp-route-no="@actionItem.ProcessNo" asp-route-version="@actionItem.ProcessVersion">修改主檔</a><a class="winform-button" asp-action="EditGraph" asp-route-no="@actionItem.ProcessNo" asp-route-version="@actionItem.ProcessVersion">節點/連線</a><form asp-action="ApproveProcess" method="post" class="winform-command-form"><input type="hidden" name="no" value="@actionItem.ProcessNo" /><input type="hidden" name="version" value="@actionItem.ProcessVersion" /><input type="hidden" name="stamp" value="@actionItem.DataStamp" /><button class="winform-button">核准</button></form> }
    @if (actionItem.IssueState == 2) { <form asp-action="NewProcessVersion" method="post" class="winform-command-form"><input type="hidden" name="no" value="@actionItem.ProcessNo" /><input type="hidden" name="version" value="@actionItem.ProcessVersion" /><button class="winform-button">複製新版本</button></form>@if (!actionItem.CurrentVersion) { <form asp-action="SetCurrentProcess" method="post" class="winform-command-form"><input type="hidden" name="no" value="@actionItem.ProcessNo" /><input type="hidden" name="version" value="@actionItem.ProcessVersion" /><input type="hidden" name="stamp" value="@actionItem.DataStamp" /><button class="winform-button">設為目前版</button></form> } }
    @if (actionItem.IssueState is 0 or 2 or -1) { <form asp-action="DeleteProcess" method="post" class="winform-command-form" onsubmit="return confirm('確定刪除或停用 @actionItem.ProcessNo/@actionItem.ProcessVersion？');"><input type="hidden" name="no" value="@actionItem.ProcessNo" /><input type="hidden" name="version" value="@actionItem.ProcessVersion" /><input type="hidden" name="state" value="@actionItem.IssueState" /><input type="hidden" name="stamp" value="@actionItem.DataStamp" /><button class="winform-button winform-button-danger">@(actionItem.IssueState == 2 ? "停用" : "刪除")</button></form> }
}
<button class="winform-button" type="button" disabled title="流程屬性 API 尚未提供">屬性</button>
@if (Model.Selected is { } drawItem && drawItem.IssueState == 0) { <a class="winform-button" asp-action="EditGraph" asp-route-no="@drawItem.ProcessNo" asp-route-version="@drawItem.ProcessVersion">Draw</a> }
<button class="winform-button" type="button" disabled title="排除作業 API 尚未提供">排除作業</button><button class="winform-button" type="button" disabled title="APS 整合 API 尚未提供">APS 整合</button><button class="winform-button" type="button" disabled title="流程匯入 API 尚未提供">匯入</button><button class="winform-button" type="button" data-export-csv data-filename="processes.csv">Download</button><button class="winform-button" type="button" data-print>Print</button><a class="winform-button" href="#" data-close-window>關閉</a>
<span class="winform-toolbar-separator"></span><span class="winform-selection">符合 @Model.Items.Count 筆；選取 @(Model.Selected is null ? "—" : $"{Model.Selected.ProcessNo}/{Model.Selected.ProcessVersion}")</span></div>
<div class="table-scroll"><table class="equipment-table master-list-table"><thead><tr><th>流程編號</th><th>流程版本</th><th>流程類型</th><th>製程段</th><th>流程分類</th><th>Partial 類型</th><th>調機流程</th><th>目前版本</th><th>說明</th><th>建立時間</th></tr></thead><tbody>
@foreach (var row in Model.Items)
{
    <tr class="@(Model.Selected?.ProcessNo == row.ProcessNo && Model.Selected?.ProcessVersion == row.ProcessVersion ? "selected-row" : "")" onclick="location.href='@Url.Action("Processes", new { keyword = Model.Keyword, issueState = Model.IssueState, no = row.ProcessNo, version = row.ProcessVersion })'"><td class="equipment-code">@row.ProcessNo</td><td>@row.ProcessVersion</td><td>@row.ProcessType</td><td>@row.ProductionSegmentNo</td><td>@row.ProcessClass</td><td>@row.PartialType</td><td>@(row.TuningProcess ? "Y" : "N")</td><td>@(row.CurrentVersion ? "CURRENT" : "")</td><td>@row.Description</td><td>@row.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td></tr>
}
@if (Model.Items.Count == 0) { <tr><td colspan="10" class="empty-state">沒有符合條件的流程版本</td></tr> }
</tbody></table></div><div class="list-footer">資料總筆數 <strong>@Model.Items.Count</strong></div></div>
<aside class="detail-panel">@if (Model.Selected is { } x) { <div class="detail-header"><div class="detail-symbol">⤳</div><div class="detail-title"><span class="eyebrow">PROCESS DETAIL</span><h2>@x.ProcessNo / @x.ProcessVersion</h2><p>@x.Description</p></div><span class="status-pill @Css(x.IssueState)"><i></i>@State(x.IssueState)</span></div>
<div class="detail-actions">@if (x.IssueState == 0) { <a class="button button-outline" asp-action="EditProcess" asp-route-no="@x.ProcessNo" asp-route-version="@x.ProcessVersion">編輯主檔</a><a class="button button-outline" asp-action="EditGraph" asp-route-no="@x.ProcessNo" asp-route-version="@x.ProcessVersion">編輯節點</a><form asp-action="ApproveProcess" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProcessNo"/><input type="hidden" name="version" value="@x.ProcessVersion"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-primary">核准</button></form> }
@if (x.IssueState == 2) { <form asp-action="NewProcessVersion" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProcessNo"/><input type="hidden" name="version" value="@x.ProcessVersion"/><button class="button button-outline">複製新版本</button></form>@if (!x.CurrentVersion) { <form asp-action="SetCurrentProcess" method="post" class="inline-form"><input type="hidden" name="no" value="@x.ProcessNo"/><input type="hidden" name="version" value="@x.ProcessVersion"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-outline">設為目前版</button></form> } }
@if (x.IssueState is 0 or 2 or -1) { <form asp-action="DeleteProcess" method="post" class="inline-form" onsubmit="return confirm('確定刪除或停用 @x.ProcessNo/@x.ProcessVersion？')"><input type="hidden" name="no" value="@x.ProcessNo"/><input type="hidden" name="version" value="@x.ProcessVersion"/><input type="hidden" name="state" value="@x.IssueState"/><input type="hidden" name="stamp" value="@x.DataStamp"/><button class="button button-ghost-danger">@(x.IssueState == 2 ? "停用" : "刪除")</button></form> }</div>
<div class="detail-section"><div class="section-heading"><h3>版本設定</h3><span>@(x.CurrentVersion ? "CURRENT" : "REVISION")</span></div><dl class="detail-grid"><div><dt>流程類型</dt><dd>@x.ProcessType</dd></div><div><dt>製程段</dt><dd>@x.ProductionSegmentNo</dd></div><div><dt>流程分類</dt><dd>@x.ProcessClass</dd></div><div><dt>調機流程</dt><dd>@(x.TuningProcess ? "是" : "否")</dd></div><div><dt>Partial Type</dt><dd>@x.PartialType</dd></div><div><dt>目前版本</dt><dd>@(x.CurrentVersion ? "是" : "否")</dd></div></dl></div>
<div class="detail-section section-separated"><div class="section-heading"><h3>流程節點</h3><span>@(Model.Graph?.Nodes.Count ?? 0) NODES</span></div>@if (Model.Graph is { } graph) { <div class="route-list">@foreach (var node in graph.Nodes.OrderBy(n => n.Sequence)) { <div class="route-node"><span class="route-sequence">@node.Sequence.ToString("00")</span><span class="route-node-main"><strong>@node.NodeNo <small>@node.NodeType</small></strong><span>@node.Description</span></span><span class="route-op">@node.OperationNo</span></div> }</div><p class="subtle-note">節點間連線：@graph.Edges.Count 條；需修改時使用「編輯節點」。</p> }</div><div class="detail-meta">建立於 @x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd") · DataStamp @x.DataStamp</div>
} else { <div class="no-selection"><div class="detail-symbol">⤳</div><h2>選擇一個流程版本</h2><p>查看流程基本設定與節點順序。</p></div> }</aside></section>
