@model EquipmentWriteRequest
@{
    var isEdit = Model.DataStamp > 0;
    var isCopy = ViewData["IsCopy"] as bool? == true;
    ViewData["Title"] = "設備基本資料";
    ViewData["ActiveMaster"] = "Equipment";
    var action = isEdit ? "Edit" : "New";
    var types = ViewData["EquipmentTypes"] as string[] ?? Array.Empty<string>();
    var classes = ViewData["EquipmentClasses"] as string[] ?? Array.Empty<string>();
    var groups = ViewData["EngineerGroups"] as string[] ?? Array.Empty<string>();
    var vendors = ViewData["Vendors"] as string[] ?? Array.Empty<string>();
    var qcLists = ViewData["QcLists"] as string[] ?? Array.Empty<string>();
}
<div class="page-heading form-heading">
    <div>
        <a class="back-link" asp-action="Index">← 返回設備主檔</a>
        <h1>設備基本資料定義 (@(isEdit ? "EDIT" : isCopy ? "COPY" : "ADD")) (EP104) 6.0.0.0</h1>
    </div>
</div>
<form asp-action="@action" asp-route-id="@Model.EquipmentNo" method="post" class="equipment-form equipment-definition">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input asp-for="DataStamp" type="hidden" />
    <input asp-for="CountEquipmentUnitQty" type="hidden" />
    <section class="form-card">
        <div class="form-card-heading"><h2>設備主檔資料</h2></div>
        <div class="winform-columns">
            <div class="form-column">
                <label class="field"><span>設備編號</span><div class="winform-inline-field"><input asp-for="EquipmentNo" class="equipment-yellow" readonly="@isEdit" /><a class="lookup-button" asp-action="New" title="新增設備">新增(A)</a></div><span asp-validation-for="EquipmentNo" class="field-error"></span></label>
                <label class="field"><span>設備名稱</span><input asp-for="EquipmentName" class="equipment-yellow" /><span asp-validation-for="EquipmentName" class="field-error"></span></label>
                <label class="field"><span>設備分類</span><input asp-for="EquipmentClass" class="equipment-yellow" list="equipmentClasses" /><datalist id="equipmentClasses">@foreach (var value in classes) { <option value="@value"></option> }</datalist></label>
                <label class="field"><span>設備型號</span><input asp-for="ModelNo" /></label>
                <label class="field"><span>批量限制</span><span class="winform-quantity"><input asp-for="Capacity" class="equipment-yellow" type="number" step="0.001" /><span class="winform-unit">(-1代表不限制)</span></span></label>
                <label class="field"><span>預設產能</span><span class="winform-quantity"><input asp-for="MaxTime" type="number" min="0" max="24" step="0.01" /><span class="winform-unit">小時</span></span></label>
                <label class="field"><span>固定機時</span><span class="winform-quantity"><input asp-for="FixEqpTime" type="number" min="0" step="0.01" /><span class="winform-unit">分鐘</span></span></label>
                <label class="field"><span>點檢表編號</span><span class="winform-inline-field"><input asp-for="QCListNo" list="equipmentQcLists" /><button class="lookup-button" type="button" data-focus-field="QCListNo">...</button></span><datalist id="equipmentQcLists">@foreach (var value in qcLists) { <option value="@value"></option> }</datalist></label>
                <label class="field"><span>說明</span><textarea asp-for="Description" rows="7"></textarea></label>
            </div>
            <div class="form-column">
                <label class="field"><span>設備類別資料</span><span class="winform-inline-field"><input asp-for="EquipmentType" class="equipment-yellow" list="equipmentTypes" /><button class="lookup-button" type="button" data-focus-field="EquipmentType">...</button></span><datalist id="equipmentTypes">@foreach (var value in types) { <option value="@value"></option> }</datalist><span asp-validation-for="EquipmentType" class="field-error"></span></label>
                <label class="field"><span>管理群組</span><span class="winform-inline-field"><input asp-for="EngineerGroupNo" class="equipment-yellow" list="engineerGroups" /><button class="lookup-button" type="button" data-focus-field="EngineerGroupNo">...</button></span><datalist id="engineerGroups">@foreach (var value in groups) { <option value="@value"></option> }</datalist><span asp-validation-for="EngineerGroupNo" class="field-error"></span></label>
                <label class="field"><span>供應商編號</span><span class="winform-inline-field"><input asp-for="VendorNo" class="equipment-yellow" list="equipmentVendors" /><button class="lookup-button" type="button" data-focus-field="VendorNo">...</button></span><datalist id="equipmentVendors">@foreach (var value in vendors) { <option value="@value"></option> }</datalist><span asp-validation-for="VendorNo" class="field-error"></span></label>
                <label class="field"><span>財產編號</span><input asp-for="AssetNo" /></label>
                <label class="field"><span>批數限制</span><span class="winform-quantity"><input asp-for="LoadPort" class="equipment-yellow" type="number" min="-1" step="1" /><span class="winform-unit">(-1代表不限制)</span></span></label>
                <label class="field"><span>機時單位批量</span><input asp-for="CountEqpUnitQty" type="number" min="0" step="1" /></label>
                <label class="field"><span>變動機時</span><span class="winform-quantity"><input asp-for="VarEqpTime" type="number" min="0" step="0.01" /><span class="winform-unit">分鐘</span></span></label>
                <div class="field"><span>自動設備</span><div class="winform-radio"><label><input type="radio" name="AutoFlag" value="1" checked="@(Model.AutoFlag == 1)" />是</label><label><input type="radio" name="AutoFlag" value="0" checked="@(Model.AutoFlag == 0)" />否</label></div></div>
                <fieldset class="winform-group">
                    <legend>訊息佇列設定</legend>
                    <label class="check-field"><input asp-for="DefaultServer" /><span>預設伺服器</span></label>
                    <label class="field"><span>佇列伺服器</span><span class="winform-inline-field"><input asp-for="QueueServer" /><button class="lookup-button" type="button" data-focus-field="QueueServer">...</button></span></label>
                    <label class="field"><span>請求訊息佇列</span><input asp-for="RequestMsgQueue" /></label>
                    <label class="field"><span>回應訊息佇列</span><input asp-for="ResponseMsgQueue" /></label>
                </fieldset>
                <details class="form-advanced">
                    <summary>其他設備整合欄位</summary>
                    <div class="form-grid">
                        <label class="field"><span>財產分類編號</span><input asp-for="EquipmentClassNo" /></label>
                        <label class="field"><span>EA Controller</span><input asp-for="EAController" /></label>
                        <label class="field"><span>設備 Recipe</span><select asp-for="EqpRecipe"><option value="0">否</option><option value="1">是</option></select></label>
                        <label class="field"><span>MES 請求佇列</span><input asp-for="RequestMsgQueueMes" /></label>
                        <label class="field"><span>EAP 回應佇列</span><input asp-for="ResponseMsgQueueEap" /></label>
                    </div>
                </details>
            </div>
        </div>
    </section>
    <div class="winform-audit">
        <label><span>建立人</span><input value="—" readonly /></label>
        <label><span>建立日期</span><input value="@ViewData["CreatedAt"]" readonly /></label>
        <label><span>修改人</span><input value="—" readonly /></label>
        <label><span>修改日期</span><input value="@ViewData["RevisedAt"]" readonly /></label>
    </div>
    <div class="form-actions"><button class="button button-primary" type="submit">確定</button><a class="button button-outline" asp-action="Index">關閉</a><button class="button" type="button" disabled>套用</button></div>
</form>