@model EquipmentIndexViewModel
@{
    ViewData["Title"] = "設備主檔";
    ViewData["ActiveMaster"] = "Equipment";
    string StateName(int state) => state switch { 0 => "未簽核", 1 => "簽核中", 2 => "已簽核", -1 => "不使用", _ => "未知" };
}
@if (TempData["Notice"] is string notice) { <div class="alert success">@notice</div> }
@if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
<section class="equipment-workspace winform-workspace">
    <div class="list-panel">
        <div class="panel-heading"><div><h2>設備</h2><span class="panel-subtitle">設備基本資料</span></div></div>
        <form class="filter-bar winform-query" method="get" asp-action="Index">
            <fieldset class="winform-state-filter"><legend>設備</legend>
                <label><input type="radio" name="issueState" value="0" checked="@(Model.IssueState == 0)" />未簽核</label>
                <label><input type="radio" name="issueState" value="1" checked="@(Model.IssueState == 1)" />簽核中</label>
                <label><input type="radio" name="issueState" value="2" checked="@(Model.IssueState == 2)" />已簽核</label>
                <label><input type="radio" name="issueState" value="-1" checked="@(Model.IssueState == -1)" />不使用</label>
            </fieldset>
            <span class="winform-search-label">設備</span>
            <select name="searchField" aria-label="查詢欄位"><option value="EquipmentNo">設備編號</option></select>
            <label class="search-box"><input type="search" name="keyword" value="@Model.Keyword" aria-label="設備編號" /></label>
            <span class="winform-like">%</span>
            <button class="button button-filter" type="submit">查詢</button>
        </form>
        <div class="winform-function-bar" role="toolbar" aria-label="設備主檔功能">
            <a class="winform-button winform-button-primary" asp-action="New">新增(A)</a>
            @if (Model.Selected is { } selected)
            {
                @if (selected.IssueState == 0) { <a class="winform-button" asp-action="Edit" asp-route-id="@selected.EquipmentNo">修改(E)</a> }
                @if (selected.IssueState is 0 or 2 or -1) { <form asp-action="Delete" method="post" class="winform-command-form" onsubmit="return confirm('確定刪除或停用 @selected.EquipmentNo？');"><input type="hidden" name="equipmentNo" value="@selected.EquipmentNo" /><button class="winform-button winform-button-danger" type="submit">刪除(D)</button></form> }
                <a class="winform-button" asp-action="Copy" asp-route-id="@selected.EquipmentNo">複製(C)</a>
                @if (selected.IssueState == 0) { <form asp-action="Approve" method="post" class="winform-command-form"><input type="hidden" name="equipmentNo" value="@selected.EquipmentNo" /><button class="winform-button" type="submit">核准</button></form> }
            }
            <button class="winform-button" type="button" disabled title="設備屬性 API 尚未提供">屬性</button>
            <button class="winform-button" type="button" disabled title="設備參數 API 尚未提供">參數</button>
            <button class="winform-button" type="button" disabled title="點檢表設定 API 尚未提供">點檢表</button>
            <button class="winform-button" type="button" data-export-csv data-filename="equipment.csv">Download</button>
            <button class="winform-button" type="button" data-print>Print</button>
            <button class="winform-button" type="button" disabled title="設備匯入 API 尚未提供">設備匯入</button>
            <a class="winform-button" href="#" data-close-window>關閉</a>
        </div>
        <div class="table-scroll"><table class="equipment-table master-list-table equipment-list-table"><thead><tr>
            <th>設備編號</th><th>設備類別資料</th><th>設備名稱</th><th>管理群組</th><th>設備分類</th><th>供應商編號</th><th>設備型號</th><th>財產編號</th><th>批量限制</th><th>批數限制</th><th>預設產能</th><th>機時單位批量</th><th>固定機時</th><th>變動機時</th><th>點檢表編號</th><th>自動設備</th><th>說明</th>
        </tr></thead><tbody>
        @foreach (var item in Model.Equipment)
        {
            var rowSelected = Model.Selected?.EquipmentNo == item.EquipmentNo;
            <tr class="@(rowSelected ? "selected-row" : "")" onclick="location.href='@Url.Action("Index", new { keyword = Model.Keyword, issueState = Model.IssueState, selectedEquipmentNo = item.EquipmentNo })'"><td class="equipment-code">@item.EquipmentNo</td><td>@item.EquipmentType</td><td>@item.EquipmentName</td><td>@item.EngineerGroupNo</td><td>@item.EquipmentClass</td><td>@item.VendorNo</td><td>@item.ModelNo</td><td>@item.AssetNo</td><td>@item.Capacity.ToString("0.###")</td><td>@item.LoadPort</td><td>@(item.MaxTime?.ToString("0.##") ?? "")</td><td>@item.CountEqpUnitQty</td><td>@(item.FixEqpTime?.ToString("0.##") ?? "")</td><td>@(item.VarEqpTime?.ToString("0.##") ?? "")</td><td>@item.QCListNo</td><td>@(item.AutoFlag == 1 ? "是" : "否")</td><td>@item.Description</td></tr>
        }
        @if (Model.Equipment.Count == 0) { <tr><td colspan="17" class="empty-state">沒有符合條件的設備資料</td></tr> }
        </tbody></table></div>
        <div class="list-footer">資料總筆數 <strong>@Model.Equipment.Count</strong></div>
    </div>
    <details class="chamber-panel">
        <summary>設備附屬 Chamber 資料（@(Model.Selected?.EquipmentNo ?? "未選取設備")）</summary>
        @if (Model.Selected is { } parent)
        {
            <div class="detail-panel">
                <div class="detail-header"><div class="detail-title"><h2>@parent.EquipmentNo　@parent.EquipmentName</h2><p>Chamber 子設備</p></div>@if (parent.IssueState is 0 or 2) { <a class="small-action" asp-action="NewChamber" asp-route-parentEquipmentNo="@parent.EquipmentNo">新增 Chamber</a> }</div>
                @if (Model.Chambers.Count == 0) { <div class="detail-section">此設備目前沒有 Chamber 子設備。</div> }
                else
                {
                    <div class="table-scroll"><table class="equipment-table"><thead><tr><th>Chamber 編號</th><th>名稱</th><th>狀態</th><th>操作</th></tr></thead><tbody>
                    @foreach (var chamber in Model.Chambers)
                    {
                        <tr><td>@chamber.EquipmentNo</td><td>@chamber.EquipmentName</td><td>@StateName(chamber.IssueState)</td><td>
                            @if (chamber.IssueState == 0) { <a asp-action="EditChamber" asp-route-parentEquipmentNo="@parent.EquipmentNo" asp-route-chamberNo="@chamber.EquipmentNo">修改</a> <form asp-action="ApproveChamber" method="post" class="winform-command-form"><input type="hidden" name="parentEquipmentNo" value="@parent.EquipmentNo"/><input type="hidden" name="chamberNo" value="@chamber.EquipmentNo"/><input type="hidden" name="stamp" value="@chamber.DataStamp"/><button class="winform-button">核准</button></form> }
                            @if (chamber.IssueState is 0 or 2 or -1) { <form asp-action="DeleteChamber" method="post" class="winform-command-form" onsubmit="return confirm('確定移除 @chamber.EquipmentNo？')"><input type="hidden" name="parentEquipmentNo" value="@parent.EquipmentNo"/><input type="hidden" name="chamberNo" value="@chamber.EquipmentNo"/><input type="hidden" name="state" value="@chamber.IssueState"/><input type="hidden" name="stamp" value="@chamber.DataStamp"/><button class="winform-button">@(chamber.IssueState == 2 ? "停用" : "刪除")</button></form> }
                        </td></tr>
                    }
                    </tbody></table></div>
                }
            </div>
        }
    </details>
</section>