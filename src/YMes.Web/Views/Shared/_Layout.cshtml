<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YMES</title>
    <link rel="stylesheet" href="~/css/legacy-mes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var activeMaster = ViewData["ActiveMaster"]?.ToString() ?? "";
    var apiBase = $"{Context.Request.PathBase}/API";
    var loginUrl = $"{Context.Request.PathBase}/";
}
<div class="app-shell" data-api-base="@apiBase" data-login-url="@loginUrl">
    <aside class="sidebar" aria-label="主選單">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="KD YMES 主選單">
            <img src="~/kd-logo.png" alt="KD 科定企業" />
        </a>
        <nav class="master-menu" aria-label="主檔功能">
            <a class="menu-home" asp-controller="Home" asp-action="Index">主選單</a>
            <details class="menu-group">
                <summary>設備管理</summary>
                <a class="menu-link @(activeMaster == "Equipment" ? "active" : "")" asp-controller="Equipment" asp-action="Index" aria-current="@(activeMaster == "Equipment" ? "page" : null)">設備主檔</a>
            </details>
            <details class="menu-group">
                <summary>作業站管理</summary>
                <a class="menu-link @(activeMaster == "Operations" ? "active" : "")" asp-controller="MasterData" asp-action="Operations" aria-current="@(activeMaster == "Operations" ? "page" : null)">作業站主檔</a>
            </details>
            <details class="menu-group">
                <summary>物料管理</summary>
                <a class="menu-link @(activeMaster == "Materials" ? "active" : "")" asp-controller="MasterData" asp-action="Materials" aria-current="@(activeMaster == "Materials" ? "page" : null)">物料主檔</a>
            </details>
            <details class="menu-group">
                <summary>流程管理</summary>
                <a class="menu-link @(activeMaster == "Processes" ? "active" : "")" asp-controller="MasterData" asp-action="Processes" aria-current="@(activeMaster == "Processes" ? "page" : null)">流程主檔</a>
            </details>
            <details class="menu-group">
                <summary>產品管理</summary>
                <a class="menu-link @(activeMaster == "Products" ? "active" : "")" asp-controller="MasterData" asp-action="Products" aria-current="@(activeMaster == "Products" ? "page" : null)">產品主檔</a>
            </details>
        </nav>
        <div class="sidebar-bottom">
            <button type="button" class="logout-button" data-ymes-logout>登出</button>
        </div>
    </aside>
    <main class="main-shell">
        <header class="page-header"><h1>@(ViewData["Title"] ?? "主選單")</h1></header>
        <div class="page-content">@RenderBody()</div>
    </main>
</div>
<script src="~/js/legacy-mes.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
