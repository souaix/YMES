# Optional: point the local UI's /YMES/API proxy at a reachable shared API host.
# Keep the value to the origin only; the browser still uses the /YMES/API path.
VITE_API_PROXY_TARGET=https://your-ymes-host

# For an isolated local preview only, enable the API launch profile's fake auth.
# VITE_LOCAL_DEMO_API=true

# Set true only when the target API does not use /YMES/API as its path base.
# Leave unset for a remote YMES API; loopback targets are stripped automatically.
# VITE_API_PROXY_STRIP_PATH_BASE=false
